.journal.create-page {
  width: 100%;
  min-width: 0;
  padding: 32rpx var(--mz-gutter,46rpx) 80rpx;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
}
.create-page .chapter-mast { flex-wrap: wrap; align-items: baseline; gap: 10rpx 20rpx; padding-bottom: 24rpx; }
.create-page .chapter-brand { min-width: 0; font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 36rpx; line-height: 1.5; letter-spacing: 2rpx; }
.create-page .chapter-no { font-size: 12px; line-height: 1.6; letter-spacing: 1rpx; }
.create-page .form-card { min-width: 0; margin: 24rpx 0 0; padding: 28rpx; border-color: #b9c5b1; border-radius: 12rpx; }
.form-title { font-size: 18px; font-weight: 500; line-height: 1.5; color: #28382e; margin-bottom: 26rpx; }
.form-header-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx 20rpx; margin-bottom: 14rpx; }
.form-header-row .form-title { margin: 0; }
.sample-count-badge { flex-shrink: 0; font-size: 12px; color: #274d3b; background: #edf1e7; padding: 8rpx 16rpx; border-radius: 12rpx; line-height: 1.5; }
.form-item { min-width: 0; margin-bottom: 26rpx; }
.form-item:last-child { margin-bottom: 0; }
.form-label { display: block; font-size: 14px; color: #374c3d; line-height: 1.6; margin-bottom: 14rpx; }
.hint-text { font-size: 12px; color: #687365; line-height: 1.8; margin: 14rpx 0 0; }
.create-page .input { width: 100%; min-width: 0; height: 48px; min-height: 44px; padding: 0 22rpx; border: 1rpx solid #b4c0ad; border-radius: 12rpx; background: #fbfaf5; color: #28382e; font-size: 16px; }
.create-page .catalog-feedback { gap: 8rpx 14rpx; margin: 14rpx 0 8rpx; line-height: 1.8; }
.create-page .catalog-retry { min-width: 44px; min-height: 44px; height: auto; padding: 12rpx 16rpx; border-radius: 12rpx; line-height: 1.5; }
.sample-entry { min-width: 0; padding: 24rpx 0; border-top: 1rpx solid #dfe3d9; }
.sample-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx 16rpx; min-height: 44px; margin-bottom: 12rpx; }
.sample-label { display: flex; flex: 1; min-width: 0; flex-wrap: wrap; align-items: center; gap: 10rpx 14rpx; line-height: 1.6; }
.sample-badge { flex-shrink: 0; font-size: 14px; font-weight: 500; color: #274d3b; background: #edf1e7; padding: 6rpx 14rpx; border-radius: 12rpx; white-space: nowrap; }
.sample-caption { font-size: 12px; color: #687365; }
.create-page button.btn-del { flex: 0 0 auto; width: auto; min-width: 44px; min-height: 44px; height: auto; margin: 0; padding: 12rpx 14rpx; background: transparent; border: 0; border-radius: 12rpx; color: #934d42; font-size: 13px; line-height: 1.5; }
.create-page .sample-input { display: block; }
.create-page .wine-suggestions { min-width: 0; margin: 12rpx 0 0; border-radius: 12rpx; overflow: hidden; }
.create-page .wine-suggestion { min-width: 0; padding: 20rpx; line-height: 1.65; }
.create-page .wine-suggestion-title, .create-page .wine-suggestion-meta { min-width: 0; word-break: break-all; overflow-wrap: anywhere; }
.add-action { margin-top: 8rpx; }
.create-page .btn-primary, .create-page .btn-secondary { width: 100%; min-height: 48px; height: auto; margin: 0; padding: 22rpx 24rpx; border-radius: 14rpx; font-size: 16px; line-height: 1.5; white-space: normal; }
.action-footer { margin-top: 32rpx; }
.chapter-brand, .hint-text, .catalog-feedback { word-break: break-all; overflow-wrap: anywhere; }
@media (max-width: 350px) {
  .journal.create-page { padding-left: var(--mz-gutter,36rpx); padding-right: var(--mz-gutter,36rpx); }
  .create-page .form-card { padding: 24rpx; }
}
