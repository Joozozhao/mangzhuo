.create-page {
  padding-bottom: 80rpx;
}
.form-card {
  margin-top: 24rpx;
}
.form-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #181713;
  margin-bottom: 20rpx;
}
.form-header-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.sample-count-badge {
  font-size: 24rpx;
  color: #893e32;
  background: #faebea;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}
.form-item {
  margin-bottom: 24rpx;
}
.form-label {
  font-size: 26rpx;
  color: #766b5d;
  margin-bottom: 12rpx;
}
.hint-text {
  font-size: 22rpx;
  color: #8c7f6d;
  line-height: 1.5;
  margin-top: 8rpx;
  margin-bottom: 20rpx;
}
.input {
  background: #fbf7ee;
  border: 1rpx solid #e6dfd3;
  border-radius: 8rpx;
  height: 84rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #181713;
  width: 100%;
}
.sample-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.sample-badge {
  font-size: 24rpx;
  font-weight: 500;
  color: #893e32;
  background: #faebea;
  padding: 10rpx 16rpx;
  border-radius: 6rpx;
  white-space: nowrap;
}
.sample-input {
  flex: 1;
}
.btn-del {
  font-size: 24rpx;
  color: #c94b40;
  padding: 12rpx 16rpx;
  white-space: nowrap;
}
.add-action {
  margin-top: 24rpx;
}
.add-btn {
  font-size: 26rpx;
  height: 80rpx;
  line-height: 80rpx;
}
.action-footer {
  margin-top: 40rpx;
}
