.rank-nav { display: flex; padding: 10rpx; margin-bottom: 24rpx; background: #ede4d3; border: none; border-radius: 20rpx; }
.nav-tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; font-weight: 700; color: #6d665a; border-radius: 16rpx; transition: all 0.2s ease; }
.nav-tab.active { background: #fffdf8; color: #181713; box-shadow: 0 4rpx 14rpx rgba(24, 23, 19, 0.08); }
.rank-intro { font-size: 24rpx; color: #877f72; margin-bottom: 24rpx; line-height: 1.5; padding: 0 10rpx; }
.rank-card { display: flex; align-items: center; padding: 28rpx 32rpx; margin-bottom: 18rpx; }
.top-1 { border: 2rpx solid #d6b06a; background: linear-gradient(135deg, #fffdf8, #fbf3e4); }
.top-2 { border: 2rpx solid #b8bac0; }
.top-3 { border: 2rpx solid #d4a57b; }
.rank-num { font-size: 40rpx; font-weight: 800; width: 64rpx; text-align: center; margin-right: 16rpx; }
.user-avatar { font-size: 48rpx; margin-right: 20rpx; }
.user-avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; }
.user-meta { flex: 1; }
.user-name { font-size: 30rpx; font-weight: 700; color: #181713; }
.user-detail { font-size: 22rpx; color: #8a8275; margin-top: 4rpx; }
.user-score-box { text-align: right; }
.score-val { font-size: 44rpx; font-weight: 800; color: #a97832; }
.score-unit { font-size: 20rpx; color: #8a8275; margin-left: 4rpx; }
.taste-card { display: flex; align-items: center; padding: 28rpx 30rpx; margin-bottom: 18rpx; }
.taste-rank-badge { font-size: 28rpx; font-weight: 800; color: #8c5d1e; background: #f4ebd9; padding: 8rpx 16rpx; border-radius: 12rpx; margin-right: 20rpx; }
.taste-main { flex: 1; }
.t-bottle { font-size: 22rpx; color: #8c5d1e; font-weight: 700; margin-bottom: 4rpx; }
.t-name { font-size: 30rpx; font-weight: 700; color: #181713; }
.t-meta { font-size: 22rpx; color: #877f72; margin-top: 4rpx; }
.taste-score-box { text-align: right; }
.t-score { font-size: 44rpx; font-weight: 800; color: #a97832; }
.t-unit { font-size: 20rpx; color: #8a8275; display: block; }
