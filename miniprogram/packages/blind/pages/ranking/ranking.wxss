.ranking-page .rank-nav { display: flex; gap: 16rpx; padding: 0; margin-bottom: 24rpx; background: transparent; border: 0; border-bottom: 1rpx solid #b9c5b1; border-radius: 0; }
.ranking-page .nav-tab { display: flex; flex: 1; width: auto; min-width: 0; min-height: 48px; align-items: center; justify-content: center; margin: 0; padding: 20rpx 4rpx; background: transparent; border-radius: 0; text-align: center; font-size: 15px; font-weight: 400; line-height: 1.5; color: #687365; border-bottom: 3rpx solid transparent; }
.ranking-page .nav-tab.active { border-bottom-color: #274d3b; color: #274d3b; font-weight: 600; }
.rank-intro { font-size: 12px; color: #687365; margin-bottom: 24rpx; line-height: 1.8; }
.rank-card { display: flex; align-items: center; padding: 28rpx 32rpx; margin-bottom: 18rpx; }
.ranking-page .top-1 { border-color: #b9c5b1; background: #edf1e7; }
.rank-num { font-family: Georgia, serif; font-size: 40rpx; font-weight: 400; color: #687365; width: 56rpx; text-align: left; margin-right: 14rpx; }
.top-1 .rank-num { color: #a8382b; }
.user-avatar { font-size: 48rpx; margin-right: 20rpx; }
.user-avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; }
.user-meta { flex: 1; min-width: 0; }
.user-name { font-size: 16px; font-weight: 500; color: #28382e; }
.user-detail { font-size: 12px; color: #687365; margin-top: 6rpx; }
.user-score-box { max-width: 30%; padding-left: 16rpx; text-align: right; }
.score-val { font-family: Georgia, serif; font-size: 44rpx; font-weight: 400; color: #274d3b; }
.score-unit { display: block; font-size: 12px; color: #687365; }
.taste-card { display: flex; align-items: center; padding: 28rpx 30rpx; margin-bottom: 18rpx; }
.taste-rank-badge { font-family: Georgia, serif; font-size: 28rpx; font-weight: 400; color: #274d3b; background: #e5eadb; padding: 10rpx 14rpx; border-radius: 8rpx; margin-right: 20rpx; }
.taste-main { flex: 1; min-width: 0; }
.t-bottle { font-size: 12px; color: #687365; font-weight: 400; margin-bottom: 6rpx; }
.t-name { font-size: 16px; font-weight: 500; color: #28382e; }
.t-meta { font-size: 12px; color: #687365; margin-top: 8rpx; }
.taste-score-box { padding-left: 16rpx; text-align: right; }
.t-score { font-family: Georgia, serif; font-size: 44rpx; font-weight: 400; color: #274d3b; }
.t-unit { font-size: 12px; color: #687365; display: block; }
.rank-num, .user-avatar, .taste-rank-badge, .user-score-box, .taste-score-box { flex-shrink: 0; }
.user-name, .user-detail, .t-bottle, .t-name, .t-meta { overflow-wrap: anywhere; word-break: break-all; }
@media (max-width: 350px) { .ranking-page .rank-card { flex-wrap: wrap; gap: 12rpx 0; } .user-score-box { margin-left: auto; } .user-avatar { margin-right: 12rpx; } .rank-num { width: 42rpx; margin-right: 10rpx; } .taste-rank-badge { margin-right: 14rpx; padding: 8rpx; } }
