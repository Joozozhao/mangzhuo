<view class="container form-page" wx:if="{{currentSample}}">
  <view class="stage-banner">
    <view class="stage-tag">第一阶段 · 盲猜</view>
    <view class="stage-title">你觉得这是什么酒？</view>
    <view class="stage-desc">凭色泽、酒花、挂杯与闻香、口感，大胆写下你的推测</view>
  </view>

  <view class="sample-header card">
    <view class="sample-badge">{{currentSample.number}}号酒盲样</view>
    <view class="sample-steps">第 {{sampleIndex + 1}} 款 / 共 {{samples.length}} 款</view>
  </view>

  <view class="card form-card">
    <view class="form-item">
      <text class="form-label">猜测品牌<text class="field-score">25 分</text></text>
      <input class="input" placeholder-class="form-placeholder" aria-label="猜测品牌" placeholder="例：茅台、习酒" value="{{guess.brand}}" bindinput="onInputBrand" />
      <view class="field-hint">输入关键词可联想酒款，点选后自动填入猜测。</view>
      <view class="catalog-feedback"><text wx:if="{{catalogLoading}}">正在更新酒款目录…</text><block wx:elif="{{catalogError}}"><text>{{catalogSource === 'cache' ? '暂用最近目录' : '暂用离线目录'}}，可手动填写。</text><button class="catalog-retry" bindtap="retryWineCatalog">重试</button></block><text wx:else>从酒款目录选填，参考价可自行修改。</text></view>
      <!-- 品牌联想浮层 -->
      <view class="suggestion-box" wx:if="{{suggestions.length > 0}}">
        <view class="sug-header">匹配酒款 · 点选填入猜测</view>
        <button class="sug-item" wx:for="{{suggestions}}" wx:key="product" bindtap="applySuggestion" data-item="{{item}}">
          <view class="sug-left">
            <text class="sug-brand">{{item.brand}}</text>
            <text class="sug-product">{{item.product}}</text>
          </view>
          <text class="sug-pill">{{item.aromaType}}</text>
        </button>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">猜测产品名称<text class="field-score">25 分</text></text>
      <input class="input" placeholder-class="form-placeholder" aria-label="猜测产品名称" placeholder="例：飞天、红花郎15" value="{{guess.product}}" bindinput="onInput" data-f="product" />
    </view>

    <view class="form-item">
      <text class="form-label">推断香型<text class="field-score">10 分</text></text>
      <view class="tag-grid">
        <button class="tag {{guess.aromaType === item ? 'active' : ''}}" wx:for="{{aromaOptions}}" wx:key="*this" bindtap="selectAroma" data-val="{{item}}">{{item}}</button>
      </view>
    </view>

    <view class="form-item">
      <text class="form-label">推断酒精度数<text class="field-score">10 分</text></text>
      <view class="tag-grid">
        <button class="tag {{guess.alcoholDegree === item ? 'active' : ''}}" wx:for="{{degreeOptions}}" wx:key="*this" bindtap="selectDegree" data-val="{{item}}">{{item}}</button>
      </view>
    </view>

    <view class="form-row">
      <view class="col">
        <text class="form-label">猜测年份<text class="field-score">15 分</text></text>
        <input class="input" placeholder-class="form-placeholder" aria-label="猜测年份" type="number" placeholder="例：2021" value="{{guess.year}}" bindinput="onInput" data-f="year" />
      </view>
      <view class="col">
        <text class="form-label">单瓶售价（元）<text class="field-score">15 分</text></text>
        <input class="input" placeholder-class="form-placeholder" aria-label="猜测单瓶售价，单位元" type="digit" placeholder="例：680" value="{{guess.estimatedPrice}}" bindinput="onInput" data-f="estimatedPrice" />
      </view>
    </view>
  </view>

  <view class="card preference-card">
    <view class="preference-heading">
      <view>
        <view class="form-label preference-title">喜欢程度<text class="label-optional">选填</text></view>
        <view class="preference-desc">可按 0.5 星选择（再次点同一颗星切换半星），不计入得分。</view>
      </view>
      <text class="preference-value {{guess.likeLevel ? 'has-value' : ''}}">{{guess.likeLevel ? guess.likeLevel + ' 星 / 10' : '未选择'}}</text>
    </view>
    <view class="star-grid" aria-label="喜欢程度，0.5 至 10 星">
      <button wx:for="{{likeLevels}}" wx:key="*this" class="star-button {{guess.likeLevel >= item ? 'is-lit' : (guess.likeLevel === item - 0.5 ? 'is-half' : '')}}" data-value="{{item}}" bindtap="selectLikeLevel" aria-label="喜欢程度 {{item}} 星（再点一次为 {{item - 0.5}} 星）" aria-pressed="{{guess.likeLevel === item || guess.likeLevel === item - 0.5}}">
        <view class="star-glyph" aria-hidden="true">
          <text class="star-base">★</text>
          <view class="star-fill {{guess.likeLevel >= item ? 'fill-full' : (guess.likeLevel === item - 0.5 ? 'fill-half' : '')}}">
            <text class="star-top">★</text>
          </view>
        </view>
        <text class="star-number">{{item}}</text>
      </button>
    </view>
    <view class="preference-scale"><text>不太喜欢</text><text>非常喜欢</text></view>
  </view>

  <view class="page-actions">
    <button class="btn-primary" bindtap="nextToScoring">下一步：给 {{currentSample.number}} 号酒打分</button>
  </view>
</view>
