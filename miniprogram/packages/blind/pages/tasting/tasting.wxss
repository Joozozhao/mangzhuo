.stage-banner { margin-bottom: 24rpx; }
.stage-tag { display: inline-block; font-size: 22rpx; font-weight: 700; background: #171714; color: #fff; padding: 4rpx 14rpx; border-radius: 10rpx; margin-bottom: 12rpx; }
.stage-title { font-size: 38rpx; font-weight: 800; color: #181713; }
.stage-desc { font-size: 24rpx; color: #7f786d; margin-top: 6rpx; }
.sample-header { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 32rpx; margin-bottom: 24rpx; background: #fffdf9; }
.sample-badge { font-size: 32rpx; font-weight: 800; color: #a97832; }
.sample-steps { font-size: 24rpx; color: #8a8376; font-weight: 600; }
.form-card { padding: 32rpx; margin-bottom: 40rpx; }
.form-item { margin-bottom: 28rpx; position: relative; }
.form-label { font-size: 26rpx; font-weight: 700; color: #2e2a22; margin-bottom: 12rpx; display: block; }
.suggestion-box { margin-top: 14rpx; background: #fbf7ee; border: 1.5rpx solid #d7b36d; border-radius: 16rpx; padding: 14rpx 18rpx; box-shadow: 0 6rpx 20rpx rgba(169, 120, 50, 0.1); }
.sug-header { font-size: 20rpx; color: #8c5d1e; font-weight: 700; margin-bottom: 8rpx; }
.sug-item { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 10rpx; border-bottom: 1rpx solid #ede3cf; }
.sug-item:last-child { border-bottom: none; }
.sug-left { display: flex; flex-direction: column; }
.sug-brand { font-size: 26rpx; font-weight: 700; color: #181713; }
.sug-product { font-size: 22rpx; color: #756d5f; }
.sug-pill { font-size: 20rpx; background: #f4ebd9; color: #8c5d1e; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.tag-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 12rpx 22rpx; border-radius: 14rpx; background: #fbf7ee; border: 1rpx solid #ded6c9; font-size: 24rpx; color: #4b453a; }
.tag.active { background: #a97832; color: #fff; border-color: #a97832; font-weight: 600; }
.form-row { display: flex; gap: 20rpx; }
.form-row .col { flex: 1; }