.form-page .page-title { color: #274d3b; }
.stage-banner { margin-bottom: 32rpx; }
.stage-tag { display: inline-block; max-width: 100%; margin-bottom: 16rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: #eef1e8; color: #274d3b; font-size: 12px; line-height: 1.6; }
.stage-title { color: #274d3b; font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 40rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.stage-desc { margin-top: 14rpx; color: #657160; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
.form-page .sample-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 24rpx; padding: 24rpx 28rpx; margin-bottom: 28rpx; background: #f0f2e9; border-color: #d6ddcf; }
.sample-badge { color: #274d3b; font-size: 16px; font-weight: 600; line-height: 1.6; }
.form-item { position: relative; min-width: 0; margin-bottom: 36rpx; }
.form-item:last-child { margin-bottom: 0; }
.sample-steps { color: #657160; font-size: 13px; line-height: 1.6; }
.form-page .form-card { margin-bottom: 24rpx; }
.field-score { display: inline-block; margin-left: 16rpx; color: #657160; font-size: 12px; font-weight: 400; white-space: nowrap; }
.field-hint, .photo-hint { margin-top: 12rpx; color: #657160; font-size: 12px; line-height: 1.8; overflow-wrap: anywhere; }
.suggestion-box { margin-top: 16rpx; padding: 20rpx 24rpx; border: 1rpx solid #ccd4c4; border-radius: 14rpx; background: #f0f2e9; }
.sug-header { margin-bottom: 8rpx; color: #657160; font-size: 12px; line-height: 1.7; }
.form-page button.sug-item { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; width: 100%; min-width: 0; padding: 20rpx 0; border: 0; border-bottom: 1rpx solid #d6ddcf; border-radius: 0; background: transparent; text-align: left; line-height: 1.6; }
.form-page button.sug-item:last-child { border-bottom: 0; }
.sug-left { display: flex; flex: 1 1 220rpx; flex-direction: column; min-width: 0; gap: 4rpx; }
.sug-brand { color: #274d3b; font-size: 14px; font-weight: 600; overflow-wrap: anywhere; word-break: break-all; }
.sug-product { color: #657160; font-size: 13px; overflow-wrap: anywhere; word-break: break-all; }
.sug-pill { max-width: 100%; padding: 6rpx 12rpx; border-radius: 12rpx; background: #e6ecdf; color: #374c3d; font-size: 12px; overflow-wrap: anywhere; word-break: break-all; }
.tag-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.form-page button.tag { display: flex; align-items: center; justify-content: center; width: auto; max-width: 100%; padding: 16rpx 22rpx; border: 1rpx solid #ccd4c4; border-radius: 14rpx; background: #fbfaf5; color: #374c3d; overflow-wrap: anywhere; word-break: break-all; }
.form-page button.tag.active { border-color: #274d3b; background: #274d3b; color: #f7f6ef; }
.form-row { display: flex; align-items: flex-start; gap: 24rpx; min-width: 0; margin-bottom: 36rpx; }
.form-row .col { flex: 1 1 0; }
@media (max-width: 360px) { .form-row { flex-direction: column; gap: 28rpx; } .form-row .col { flex: none; width: 100%; } }
.form-page .preference-card { margin-bottom: 28rpx; background: #f3f5ed; border-color: #d6ddcf; }
.preference-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; }
.preference-heading .preference-title { margin-bottom: 8rpx; }
.label-optional { margin-left: 12rpx; color: #657160; font-size: 12px; font-weight: 400; }
.preference-desc { color: #657160; font-size: 12px; line-height: 1.7; }
.preference-value { flex-shrink: 0; padding-top: 4rpx; color: #657160; font-size: 13px; line-height: 1.6; }
.preference-value.has-value { color: #8c682f; font-weight: 600; }
.star-grid { display: flex; align-items: center; justify-content: space-between; gap: 2rpx; margin-top: 12rpx; }
.form-page button.star-button { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; width: auto; min-width: 0; min-height: 44px; height: 44px; padding: 0; border: 0; border-radius: 8rpx; background: transparent; color: #a6ad9f; line-height: 1; }
.form-page button.star-button.is-lit,
.form-page button.star-button.is-half { background: transparent; color: #b18338; }
.form-page button.star-button:active { background: #f4ead6; }
.star-glyph { position: relative; display: inline-block; width: 21px; height: 22px; font-family: Arial, sans-serif; font-size: 21px; line-height: 22px; text-align: center; }
.star-base { display: block; width: 21px; color: #cfd5c8; }
.star-fill { position: absolute; top: 0; left: 0; width: 0; height: 22px; overflow: hidden; }
.star-fill.fill-half { width: 50%; }
.star-fill.fill-full { width: 100%; }
.star-top { display: block; width: 21px; color: #b18338; }
.star-number { margin-top: 2rpx; font-size: 9px; line-height: 1.2; }
.preference-scale { display: flex; justify-content: space-between; margin-top: 12rpx; color: #78816f; font-size: 11px; line-height: 1.6; }
.page-actions { padding-top: 8rpx; }
