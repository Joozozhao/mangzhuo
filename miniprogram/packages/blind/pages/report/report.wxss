.report-cover { text-align: center; padding: 48rpx 32rpx; margin-bottom: 30rpx; background: linear-gradient(145deg, #171714, #2c2822); color: #fff; border: 1rpx solid #473e30; }
.cover-brand { font-size: 24rpx; color: #d6b06a; font-weight: 700; letter-spacing: 2rpx; margin-bottom: 16rpx; }
.cover-title { font-size: 46rpx; font-weight: 800; margin-bottom: 16rpx; color: #ffffff; }
.cover-quote { font-size: 24rpx; color: #b8b0a1; line-height: 1.6; max-width: 600rpx; margin: 0 auto 30rpx; }
.cover-divider { height: 1rpx; background: rgba(214, 176, 106, 0.3); margin: 0 40rpx 30rpx; }
.cover-stats { display: flex; justify-content: space-around; }
.cs-col { text-align: center; }
.cs-v { font-size: 40rpx; font-weight: 800; color: #d6b06a; display: block; }
.cs-k { font-size: 22rpx; color: #a49d90; margin-top: 4rpx; }
.award-grid { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 40rpx; }
.award-card { padding: 36rpx 32rpx; }
.gold-glow { border: 2rpx solid #d6b06a; background: linear-gradient(135deg, #fffdf8, #fcf6eb); }
.award-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.award-icon { font-size: 36rpx; margin-right: 12rpx; }
.award-badge { font-size: 22rpx; font-weight: 700; color: #8c5d1e; background: #f4e7ca; padding: 6rpx 18rpx; border-radius: 12rpx; }
.tag-green { background: #eaf4ed; color: #2e8b57; }
.tag-dark { background: #ede4d3; color: #474033; }
.tag-gold { background: linear-gradient(135deg, #d6b06a, #a97832); color: #fff; }
.award-sample { font-size: 24rpx; color: #a97832; font-weight: 700; margin-bottom: 6rpx; }
.award-wine { font-size: 38rpx; font-weight: 800; color: #181713; margin-bottom: 12rpx; }
.award-score { font-size: 26rpx; color: #6d6558; }
.hl-score { font-size: 44rpx; font-weight: 800; color: #a97832; margin: 0 6rpx; }
.price-compare-box { font-size: 24rpx; color: #5a5448; font-weight: 600; display: flex; align-items: center; }
.price-compare-box .sep { margin: 0 12rpx; color: #c4baa7; }
.high-tag { color: #2e8b57; font-weight: 800; }
.hard-stat { font-size: 26rpx; color: #686154; }
.hl-hard { font-size: 36rpx; font-weight: 800; color: #c94b40; margin: 0 6rpx; }
.guesser-user { display: flex; align-items: center; margin-bottom: 10rpx; }
.guesser-avatar { font-size: 48rpx; margin-right: 16rpx; }
.guesser-avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; }
.guesser-name { font-size: 34rpx; font-weight: 800; color: #181713; }
.guesser-score { font-size: 26rpx; color: #686154; }
.award-footer { font-size: 22rpx; color: #877f72; border-top: 1rpx dashed #ede4d3; padding-top: 16rpx; margin-top: 20rpx; line-height: 1.5; }
.report-actions { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 60rpx; }
.poster-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; display: flex; align-items: center; justify-content: center; }
.modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.65); }
.modal-content { position: relative; z-index: 1000; width: 620rpx; background: #fffdf8; border-radius: 28rpx; padding: 30rpx; text-align: center; }
.poster-img { width: 100%; border-radius: 18rpx; box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.15); margin-bottom: 24rpx; }
.modal-btns { display: flex; flex-direction: column; gap: 16rpx; }
