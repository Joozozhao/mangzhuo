.report-page .report-cover { text-align: left; padding: 32rpx 28rpx; margin-bottom: 32rpx; background: #274d3b; color: #fbfaf5; border-color: #274d3b; }
.cover-brand { font-size: 12px; color: #d3ddcb; font-weight: 400; letter-spacing: 3rpx; margin-bottom: 20rpx; }
.cover-title { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; line-height: 1.5; font-weight: 400; margin-bottom: 16rpx; color: #fbfaf5; }
.cover-quote { font-size: 14px; color: #e1e8db; line-height: 1.8; margin-bottom: 28rpx; }
.cover-divider { height: 1rpx; background: #6f8b76; margin-bottom: 28rpx; }
.cover-stats { display: flex; justify-content: space-around; }
.cs-col { flex: 1; min-width: 0; padding: 0 8rpx; text-align: center; overflow-wrap: anywhere; }
.cs-col + .cs-col { border-left: 1rpx solid #6f8b76; }
.cs-v { font-family: Georgia, serif; font-size: 40rpx; font-weight: 400; color: #fbfaf5; display: block; }
.cs-k { font-size: 12px; color: #d3ddcb; margin-top: 8rpx; }
.award-grid { display: flex; flex-direction: column; gap: 24rpx; margin-bottom: 32rpx; }
.report-page .award-card { margin-bottom: 0; }
.award-card { padding: 36rpx 32rpx; }
.report-page .gold-glow { border-color: #b9c5b1; background: #fbfaf5; }
.award-header { display: flex; align-items: center; margin-bottom: 20rpx; }
.award-index { flex-shrink: 0; font-family: Georgia, serif; font-size: 32rpx; color: #78866f; margin-right: 16rpx; }
.award-badge { font-size: 12px; font-weight: 500; color: #a8382b; background: #f7edea; border: 1rpx solid #dcb2a8; padding: 6rpx 16rpx; border-radius: 8rpx; }
.tag-green, .tag-dark { background: #edf0e7; color: #274d3b; border-color: #cbd3c2; }
.tag-gold { background: #f7edea; color: #a8382b; }
.award-sample { font-size: 12px; color: #687365; font-weight: 400; margin-bottom: 8rpx; }
.award-wine { font-family: "Songti SC", "STSong", serif; font-size: 40rpx; line-height: 1.5; font-weight: 400; color: #28382e; margin-bottom: 16rpx; }
.award-score { font-size: 14px; color: #687365; }
.hl-score { font-family: Georgia, serif; font-size: 44rpx; font-weight: 400; color: #274d3b; margin: 0 8rpx; }
.price-compare-box { font-size: 24rpx; color: #5a5448; font-weight: 600; display: flex; flex-wrap: wrap; gap: 8rpx 0; align-items: center; }
.price-compare-box .sep { margin: 0 12rpx; color: #c4baa7; }
.high-tag { color: #274d3b; font-weight: 500; }
.hard-stat { font-size: 14px; color: #687365; }
.hl-hard { font-family: Georgia, serif; font-size: 40rpx; font-weight: 400; color: #a8382b; margin: 0 8rpx; }
.guesser-user { display: flex; min-width: 0; align-items: center; margin-bottom: 10rpx; }
.guesser-avatar { flex-shrink: 0; font-size: 48rpx; margin-right: 16rpx; }
.guesser-avatar-img { width: 64rpx; height: 64rpx; border-radius: 50%; }
.guesser-name { min-width: 0; font-size: 17px; font-weight: 500; color: #28382e; }
.guesser-score { font-size: 14px; color: #687365; }
.award-footer { font-size: 12px; color: #687365; border-top: 1rpx dashed #bac5b0; padding-top: 20rpx; margin-top: 24rpx; line-height: 1.8; }
.report-actions { display: flex; flex-direction: column; gap: 20rpx; padding-bottom: 60rpx; }
.poster-modal { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 999; display: flex; align-items: center; justify-content: center; padding: 32rpx; padding-top: calc(32rpx + env(safe-area-inset-top)); padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); }
.modal-mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(24,23,19,0.48); }
.modal-content { position: relative; z-index: 1000; display: flex; flex-direction: column; width: 640rpx; max-width: 100%; min-height: 0; max-height: calc(100vh - 64rpx - env(safe-area-inset-top) - env(safe-area-inset-bottom)); overflow: hidden; background: #fbfaf5; border: 1rpx solid #b9c5b1; border-radius: 16rpx; padding: 28rpx; text-align: center; }
.poster-scroll { flex: 0 1 auto; width: 100%; height: 875rpx; min-height: 0; max-height: calc(100vh - 164rpx - 88px - env(safe-area-inset-top) - env(safe-area-inset-bottom)); margin-bottom: 24rpx; }
.poster-img { display: block; width: 100%; border-radius: 8rpx; border: 1rpx solid #d6ddcf; }
.modal-btns { display: flex; flex: 0 0 auto; flex-direction: column; gap: 16rpx; }
.modal-btns button { min-width: 44px; min-height: 44px; height: auto; margin: 0; padding: 20rpx; line-height: 1.5; }
.cover-title, .award-wine, .guesser-name, .price-compare-box > text { overflow-wrap: anywhere; word-break: break-all; }
