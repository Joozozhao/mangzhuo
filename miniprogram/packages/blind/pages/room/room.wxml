<view class="container" wx:if="{{room}}">
  <view class="room-banner card">
    <view class="banner-top">
      <view class="banner-code" bindtap="copyRoomCode">
        <text class="c-label">房间码</text>
        <text class="c-val">{{room.roomCode}}</text>
        <text class="c-copy">复制</text>
      </view>
      <view class="status-pill status-{{room.status}}">{{room.status === 'revealed' ? '已开奖揭晓' : (isAllSubmitted ? '全员已交卷' : '盲测进行中')}}</view>
    </view>
    <view class="banner-name">{{room.name}}</view>
    <view class="banner-desc">{{room.description}}</view>
    <view class="share-hint">💬 现场好友输入房间码 <text class="highlight">{{room.roomCode}}</text> 或直接扫码入局</view>
  </view>

  <view class="section-header">
    <text class="section-title">现场酒样盲品进度</text>
    <text class="section-sub">{{mySubmittedCount}} / {{samples.length}} 款已完成</text>
  </view>
  <view class="sample-list">
    <view class="sample-item card" wx:for="{{samples}}" wx:key="sampleId" bindtap="startSampleTasting" data-index="{{index}}">
      <view class="sample-left">
        <view class="bottle-badge">{{item.number}}号酒</view>
        <view class="sample-meta">
          <view class="meta-title">第 {{item.number}} 杯神秘盲样</view>
          <view class="meta-status {{myStatusMap[item.sampleId] ? 'status-done' : ''}}">
            {{myStatusMap[item.sampleId] ? "✓ 我已完成盲猜 & 评分" : "👉 点击开始盲猜 & 评分"}}
          </view>
        </view>
      </view>
      <view class="sample-arrow">→</view>
    </view>
  </view>

  <view class="section-header">
    <text class="section-title">入局品鉴官 ({{members.length}}人)</text>
    <text class="section-sub">{{isAllSubmitted ? "所有人已交卷，可开奖" : "品鉴进行中"}}</text>
  </view>
  <view class="card members-card">
    <view class="member-grid">
      <view class="member-chip" wx:for="{{members}}" wx:key="userId">
        <image wx:if="{{item.avatarImg}}" class="member-avatar member-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
        <view wx:else class="member-avatar">{{item.avatar || "🍶"}}</view>
        <view class="member-info">
          <view class="m-name">{{item.nickname}} <text class="m-tag" wx:if="{{item.role === 'owner'}}">房主</text></view>
          <view class="m-state {{item.isSubmitted ? 'state-done' : ''}}">{{item.isSubmitted ? "✓ 已交卷" : "品评中"}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-actions">
    <button class="btn-primary" wx:if="{{room.status !== 'revealed'}}" bindtap="triggerReveal">👑 房主公布答案 & 立即开奖</button>
    <button class="btn-primary" wx:else bindtap="goToReveal">🏆 查看开奖总榜 & 完整报告</button>
    <button class="btn-secondary" open-type="share" style="margin-top: 16rpx;">邀请微信好友入局</button>
  </view>
</view>
