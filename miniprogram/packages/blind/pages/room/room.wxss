.room-page .room-banner { margin-bottom: 32rpx; background: #fbfaf5; }
.banner-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; margin-bottom: 20rpx; }
.room-page .banner-code { display: inline-flex; align-items: center; width: auto; min-width: 44px; min-height: 44px; max-width: 100%; margin: 0; background: #e5eadb; color: #274d3b; padding: 8rpx 20rpx; border: 1rpx dashed #b9c5b1; border-radius: 12rpx; line-height: 1.5; }
.c-label { font-size: 22rpx; opacity: 0.7; margin-right: 10rpx; }
.c-val { font-family: Georgia, serif; font-size: 34rpx; font-weight: 400; color: #274d3b; letter-spacing: 2rpx; }
.c-copy { font-size: 12px; color: #274d3b; padding: 2rpx 10rpx; margin-left: 12rpx; }
.banner-name { font-family: "Songti SC", "STSong", serif; font-size: 44rpx; font-weight: 400; color: #28382e; line-height: 1.5; margin-bottom: 12rpx; }
.banner-desc { font-size: 14px; color: #687365; line-height: 1.8; margin-bottom: 20rpx; }
.share-hint { font-size: 12px; color: #687365; border-top: 1rpx dashed #bac5b0; padding-top: 20rpx; }
.highlight { color: #274d3b; font-weight: 500; }
.section-header { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 12rpx; margin-bottom: 18rpx; margin-top: 10rpx; }
.section-title { font-size: 32rpx; font-weight: 700; color: #181713; }
.section-sub { font-size: 12px; color: #687365; }
.sample-list { margin-bottom: 30rpx; }
.room-page .room-empty { border-style: dashed; }
.room-empty .banner-desc { margin: 12rpx 0 0; }
.sample-item { display: flex; align-items: center; justify-content: space-between; width: 100% !important; max-width: 100% !important; margin: 0 0 24rpx !important; margin-left: 0 !important; margin-right: 0 !important; padding: 28rpx; text-align: left; line-height: 1.7; }
.sample-left { display: flex; flex: 1; min-width: 0; align-items: center; }
.sample-meta { min-width: 0; }
.bottle-badge { flex-shrink: 0; width: 90rpx; height: 90rpx; border-radius: 12rpx; background: #e5eadb; color: #274d3b; font-weight: 500; font-size: 14px; display: flex; align-items: center; justify-content: center; margin-right: 24rpx; }
.meta-title { font-size: 16px; font-weight: 500; color: #28382e; margin-bottom: 6rpx; }
.meta-status { font-size: 12px; color: #687365; }
.meta-status.status-done { color: #274d3b; font-weight: 500; }
.sample-arrow { flex-shrink: 0; font-size: 32rpx; color: #274d3b; }
.members-card { padding: 24rpx; margin-bottom: 40rpx; }
.member-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 16rpx; }
.member-chip { display: flex; min-width: 0; align-items: center; background: #f0f2e9; padding: 16rpx 20rpx; border-radius: 12rpx; border: 1rpx solid #d6ddcf; }
.member-info { flex: 1; min-width: 0; }
.member-avatar { flex-shrink: 0; font-size: 40rpx; margin-right: 14rpx; }
.member-avatar-img { width: 56rpx; height: 56rpx; border-radius: 50%; }
.m-name { font-size: 14px; font-weight: 500; color: #28382e; display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.m-level-badge { display: inline-block; font-size: 10px; background: #e5eadb; color: #274d3b; padding: 2rpx 8rpx; border-radius: 6rpx; font-weight: 600; font-family: "Songti SC", "STSong", serif; }
.m-tag { display: inline-block; font-size: 11px; background: #e5eadb; color: #274d3b; padding: 2rpx 8rpx; border-radius: 6rpx; margin-left: 6rpx; font-weight: normal; }
.m-state { font-size: 12px; color: #687365; margin-top: 4rpx; }
.m-state.state-done { color: #274d3b; font-weight: 500; }
.bottom-actions { margin-top: 20rpx; padding-bottom: 60rpx; }
.banner-name, .banner-desc, .share-hint, .m-name, .m-state, .meta-title, .meta-status { overflow-wrap: anywhere; word-break: break-all; }
@media (max-width: 350px) { .member-grid { grid-template-columns: minmax(0, 1fr); } .bottle-badge { margin-right: 16rpx; } }
