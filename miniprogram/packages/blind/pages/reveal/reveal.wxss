.reveal-hero { text-align: center; padding: 44rpx 32rpx; margin-bottom: 30rpx; background: linear-gradient(135deg, #fffdf8, #f8f1e2); border: 2rpx solid #d7b36d; }
.rh-badge { display: inline-block; font-size: 24rpx; font-weight: 700; color: #8c5d1e; background: #f4e7ca; padding: 6rpx 20rpx; border-radius: 20rpx; margin-bottom: 16rpx; }
.rh-title { font-size: 42rpx; font-weight: 800; color: #181713; margin-bottom: 8rpx; }
.rh-sub { font-size: 26rpx; color: #827b70; margin-bottom: 30rpx; }
.nav-shortcuts { display: flex; gap: 20rpx; justify-content: center; }
.shortcut-btn { flex: 1; height: 86rpx; font-size: 28rpx; }
.sample-reveal-card { padding: 32rpx; margin-bottom: 26rpx; }
.src-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx; margin-bottom: 16rpx; }
.src-bottle-tag { font-size: 24rpx; font-weight: 800; color: #8c5d1e; background: #f4ebd9; padding: 6rpx 18rpx; border-radius: 12rpx; }
.src-score-badge { display: flex; align-items: baseline; }
.sb-label { font-size: 22rpx; color: #827a6f; margin-right: 8rpx; }
.sb-val { font-size: 38rpx; font-weight: 800; color: #a97832; }
.src-real-info { margin-bottom: 18rpx; }
.src-sample-photo { display: block; width: 100%; height: 420rpx; border-radius: 12rpx; margin-bottom: 24rpx; background: #eee7dc; }
.real-brand { font-size: 38rpx; font-weight: 800; color: #181713; }
.real-product { font-size: 30rpx; font-weight: 600; color: #443e35; margin-top: 4rpx; }
.src-tags-row { display: flex; flex-wrap: wrap; gap: 10rpx; margin-bottom: 24rpx; }
.info-pill { font-size: 22rpx; background: #f4efe4; color: #5a5448; padding: 6rpx 16rpx; border-radius: 10rpx; }
.price-pill { background: #171714; color: #fff; font-weight: 600; }
.comparison-bar { display: flex; align-items: center; justify-content: space-around; background: #fbf7ee; border-radius: 16rpx; padding: 18rpx 12rpx; margin-bottom: 20rpx; border: 1rpx solid #ede3d1; }
.comp-col { flex: 1; min-width: 0; text-align: center; overflow-wrap: anywhere; word-break: break-all; }
.comp-k { font-size: 20rpx; color: #877f72; display: block; }
.comp-v { font-size: 26rpx; font-weight: 800; color: #181713; margin-top: 4rpx; }
.comp-divider { flex-shrink: 0; color: #d8cebd; font-size: 22rpx; }
.diff-high { color: #c94b40; }
.diff-low { color: #2e8b57; }
.notes-quote { font-size: 24rpx; color: #6e675b; font-style: italic; background: #faf6ed; padding: 16rpx 20rpx; border-left: 6rpx solid #a97832; margin-bottom: 20rpx; border-radius: 4rpx; }
.mini-btn { height: 76rpx; font-size: 26rpx; width: 100%; }
.reveal-knowledge { border-top: 1rpx solid #e6dfd3; padding-top: 20rpx; margin-bottom: 24rpx; }
.knowledge-caption { color: #897b68; font-size: 23rpx; }
.reveal-knowledge .knowledge-link { display: flex; align-items: center; width: 100% !important; min-width: 0; min-height: 44px; height: auto; text-align: left; background: transparent; color: #893e32; font-size: 27rpx; line-height: 1.6; padding: 14rpx 0; margin: 0; white-space: normal; overflow-wrap: anywhere; word-break: break-all; }
.real-brand, .real-product, .info-pill, .notes-quote { max-width: 100%; overflow-wrap: anywhere; word-break: break-all; }
