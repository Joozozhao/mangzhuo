.container { padding-bottom: 80rpx; }
.label-row { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16rpx; }
.form-item { margin-bottom: 32rpx; }
.form-label { font-size: 28rpx; font-weight: 700; color: #181713; margin-bottom: 14rpx; display: block; }
.chip-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chip { padding: 16rpx 32rpx; border-radius: 16rpx; border: 1rpx solid #ded6c9; background: #fffdf8; color: #555047; font-size: 26rpx; font-weight: 600; }
.chip.active { background: #171714; color: #fff; border-color: #171714; }
.rule-box { background: #fbf7ee; border: 1rpx solid #e7ddca; }
.rule-title { font-size: 28rpx; font-weight: 700; color: #8c5d1e; margin-bottom: 20rpx; }
.rule-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14rpx; margin-bottom: 18rpx; }
.rule-item { display: flex; justify-content: space-between; background: #fff; padding: 12rpx 18rpx; border-radius: 12rpx; border: 1rpx solid #ede4d3; font-size: 24rpx; }
.r-k { color: #5a5448; } .r-v { color: #a97832; font-weight: 700; }
.rule-tip { font-size: 22rpx; color: #8c8477; line-height: 1.5; }