.form-page .page-title { color: #274d3b; }
.form-page .profile-hint { display: block; width: 100%; margin: 0 0 28rpx; padding: 20rpx 24rpx; border: 1rpx solid #ccd4c4; border-radius: 14rpx; background: #eef1e8; color: #374c3d; text-align: left; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
.form-item { position: relative; min-width: 0; margin-bottom: 36rpx; }
.form-item:last-child { margin-bottom: 0; }
.label-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.label-row .form-label { margin-bottom: 0; }
.form-page .gold-badge, .form-page .badge-gray { background: #eef1e8; color: #274d3b; border-radius: 12rpx; line-height: 1.6; }
.chip-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12rpx; }
.form-page button.chip { display: flex; align-items: center; justify-content: center; width: 100%; padding: 16rpx 12rpx; border: 1rpx solid #ccd4c4; border-radius: 14rpx; background: #fbfaf5; color: #374c3d; overflow-wrap: anywhere; }
.form-page button.chip.active { background: #274d3b; color: #f7f6ef; border-color: #274d3b; }
.form-page .rule-box { background: #f0f2e9; border-color: #d6ddcf; }
.rule-title { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; margin-bottom: 24rpx; color: #274d3b; font-size: 15px; font-weight: 600; line-height: 1.6; }
.rule-total { color: #657160; font-size: 12px; font-weight: 400; }
.rule-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.rule-item { display: flex; align-items: baseline; justify-content: space-between; flex-wrap: wrap; gap: 4rpx 12rpx; min-width: 0; padding: 16rpx; border: 1rpx solid #dfe3d9; border-radius: 12rpx; background: #fbfaf5; font-size: 13px; line-height: 1.6; }
.r-k { color: #374c3d; overflow-wrap: anywhere; }
.r-v { flex-shrink: 0; color: #274d3b; font-weight: 600; }
.rule-tip { color: #657160; font-size: 12px; line-height: 1.8; overflow-wrap: anywhere; }
.page-actions { padding-top: 8rpx; }
