.form-page .page-title { color: #274d3b; }
.stage-banner { margin-bottom: 32rpx; }
.stage-tag { display: inline-block; max-width: 100%; margin-bottom: 16rpx; padding: 8rpx 16rpx; border-radius: 12rpx; background: #eef1e8; color: #274d3b; font-size: 12px; line-height: 1.6; }
.stage-title { color: #274d3b; font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 40rpx; font-weight: 500; line-height: 1.5; overflow-wrap: anywhere; }
.stage-desc { margin-top: 14rpx; color: #657160; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
.form-page .sample-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx 24rpx; padding: 24rpx 28rpx; margin-bottom: 28rpx; background: #f0f2e9; border-color: #d6ddcf; }
.sample-badge { color: #274d3b; font-size: 16px; font-weight: 600; line-height: 1.6; }
.total-preview { color: #657160; font-size: 13px; line-height: 1.6; }
.score-num { color: #274d3b; font-size: 24px; font-weight: 600; }
.form-page .dim-card { margin-bottom: 28rpx; }
.dim-item { margin-bottom: 28rpx; padding-bottom: 20rpx; border-bottom: 1rpx solid #dfe3d9; }
.dim-item:last-child { margin-bottom: 0; padding-bottom: 0; border-bottom: 0; }
.dim-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 20rpx; margin-bottom: 8rpx; }
.dim-copy { flex: 1; min-width: 0; }
.dim-label { display: block; color: #374c3d; font-size: 14px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; }
.dim-sub { display: block; margin-top: 6rpx; color: #657160; font-size: 12px; line-height: 1.7; overflow-wrap: anywhere; }
.dim-val { flex-shrink: 0; color: #274d3b; font-size: 16px; font-weight: 600; line-height: 1.6; white-space: nowrap; }
.rating-slider { min-height: 44px; margin: 4rpx 0 0; }
.form-page .comment-card { margin-bottom: 24rpx; }
.page-actions { padding-top: 8rpx; }
