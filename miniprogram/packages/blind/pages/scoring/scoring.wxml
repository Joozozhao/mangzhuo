<view class="container form-page" wx:if="{{currentSample}}">
  <view class="stage-banner">
    <view class="stage-tag tag-gold">第二阶段 · 品鉴</view>
    <view class="stage-title">抛开品牌，你真正喜欢它吗？</view>
    <view class="stage-desc">白酒盲品的最高价值，是在不知品牌价格时探寻最真实的口腔喜好</view>
  </view>

  <view class="sample-header card">
    <view class="sample-badge">{{currentSample.number}}号酒品鉴</view>
    <view class="total-preview">当前综合评分：<text class="score-num">{{overallScore}}</text> 分</view>
  </view>

  <!-- 5大感官维度评分滑块 -->
  <view class="card dim-card">
    <view class="dim-item" wx:for="{{dimensions}}" wx:key="key">
      <view class="dim-top">
        <view class="dim-copy">
          <text class="dim-label">{{item.name}}</text>
          <text class="dim-sub">{{item.sub}}</text>
        </view>
        <text class="dim-val">{{rating[item.key]}} 分</text>
      </view>
      <slider class="rating-slider" aria-label="{{item.name}}评分"
        min="5" max="10" step="0.1" 
        value="{{rating[item.key]}}" 
        activeColor="#274d3b"
        backgroundColor="#dfe3d9"
        block-size="28"
        block-color="#274d3b"
        bindchange="onSliderChange" 
        bindchanging="onSliderChange"
        data-dim="{{item.key}}"
      />
    </view>
  </view>

  <view class="card comment-card">
    <text class="form-label">口感评价 / 盲品感受</text>
    <textarea class="input form-textarea" placeholder-class="form-placeholder" aria-label="口感评价或盲品感受" placeholder="例：入口顺滑，回甘绵长" value="{{rating.comment}}" bindinput="onInputComment" auto-height="{{true}}" maxlength="140" cursor-spacing="24" />
  </view>

  <view class="page-actions">
    <button class="btn-primary" bindtap="submitRating">
      {{isLastSample ? "提交并完成本局盲测" : "保存，继续评下一款酒"}}
    </button>
  </view>
</view>
