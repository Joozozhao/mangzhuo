.compare-page .sample-target { background: #e5eadb; color: #28382e; margin-bottom: 32rpx; }
.st-tag { font-size: 12px; color: #274d3b; font-weight: 500; margin-bottom: 16rpx; }
.st-brand { font-family: "Songti SC", "STSong", serif; font-size: 42rpx; line-height: 1.5; font-weight: 400; margin-bottom: 12rpx; }
.st-meta { font-size: 14px; color: #52654c; line-height: 1.8; }
.section-title { font-size: 30rpx; font-weight: 700; color: #181713; margin-bottom: 20rpx; }
.guess-card { padding: 30rpx; margin-bottom: 24rpx; }
.gc-top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12rpx 16rpx; margin-bottom: 24rpx; padding-bottom: 20rpx; border-bottom: 1rpx dashed #bac5b0; }
.gc-user { display: flex; flex: 1; min-width: 0; align-items: center; }
.u-avatar { flex-shrink: 0; font-size: 36rpx; margin-right: 12rpx; }
.u-avatar-img { width: 44rpx; height: 44rpx; border-radius: 50%; }
.u-name { min-width: 0; font-size: 16px; font-weight: 500; color: #28382e; }
.gc-score { flex-shrink: 0; font-size: 12px; color: #687365; white-space: nowrap; }
.score-bold { font-family: Georgia, serif; font-size: 40rpx; font-weight: 400; color: #274d3b; margin-left: 10rpx; }
.score-breakdown { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12rpx; margin-bottom: 20rpx; }
.sb-item { min-width: 0; padding: 18rpx 20rpx; border-radius: 8rpx; background: #f7f6ef; border: 1rpx solid #d6ddcf; }
.sb-item.hit { background: #edf1e7; border-color: #b9c5b1; }
.sb-k { font-size: 12px; color: #687365; display: block; margin-bottom: 8rpx; }
.sb-val { font-size: 14px; line-height: 1.7; font-weight: 500; color: #28382e; }
.sb-item.hit .sb-val { color: #274d3b; }
.user-taste-box { background: #f0f2e9; border-radius: 8rpx; padding: 20rpx 24rpx; font-size: 14px; line-height: 1.8; }
.font-bold { font-weight: 800; }
.ut-comment { margin-top: 10rpx; color: #52654c; }
.st-sample-photo { display: block; width: 100%; height: 360rpx; border-radius: 12rpx; margin: 18rpx 0; background: #eee7dc; }
.st-brand, .st-meta, .u-name, .sb-val, .ut-comment { overflow-wrap: anywhere; word-break: break-all; }
@media (max-width: 350px) { .score-breakdown { grid-template-columns: minmax(0, 1fr); } }
