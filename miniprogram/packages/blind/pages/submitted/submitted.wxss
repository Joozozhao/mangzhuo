.success-card { text-align: center; padding: 60rpx 40rpx; margin-bottom: 30rpx; }
.success-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.success-seal { display: inline-flex; align-items: center; justify-content: center; margin: 12rpx 0 28rpx; padding: 10rpx 20rpx; border: 1rpx solid #a8382b; border-radius: 6rpx; color: #a8382b; background: #f7edea; font-family: "Songti SC", "STSong", serif; font-size: 18px; letter-spacing: 3rpx; }
.success-title { font-family: "Songti SC", "STSong", serif; font-size: 44rpx; font-weight: 400; color: #28382e; margin-bottom: 16rpx; }
.success-desc { font-size: 14px; color: #687365; line-height: 1.8; margin-bottom: 28rpx; }
.room-code-tag { display: inline-block; background: #e5eadb; color: #274d3b; padding: 12rpx 24rpx; border-radius: 8rpx; font-weight: 500; font-size: 14px; }
.tip-card { padding: 32rpx; margin-bottom: 50rpx; background: #fcf9f2; border: 1rpx solid #ede4d3; }
.tip-head { font-size: 16px; font-weight: 500; color: #274d3b; margin-bottom: 12rpx; }
.tip-body { font-size: 14px; color: #687365; line-height: 1.8; }
.action-stack { display: flex; flex-direction: column; gap: 20rpx; }
