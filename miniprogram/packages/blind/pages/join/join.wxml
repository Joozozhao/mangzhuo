<view class="container">
  <view class="page-header">
    <view class="page-title">加入朋友的酒局</view>
    <view class="page-desc">输入桌前发起人告知的4位数字房间号，或点击下方正在进行的酒局</view>
  </view>
  <view wx:if="{{!profileCompleted}}" class="profile-hint" bindtap="goProfile">完善头像昵称，入局后好友能看到你的专属名片 →</view>
  <view class="card code-box">
    <text class="code-title">输入 4 位房间码</text>
    <view class="code-input-wrap">
      <input class="code-input" type="number" maxlength="4" placeholder="••••" value="{{roomCode}}" bindinput="onInputCode" />
    </view>
    <button class="btn-primary" bindtap="submitJoin">立即加入品鉴</button>
  </view>
  <view class="section-title">快捷体验可进房间</view>
  <view class="room-card card" wx:for="{{availableRooms}}" wx:key="roomId" bindtap="joinQuick" data-code="{{item.roomCode}}">
    <view class="r-top">
      <text class="gold-badge">房间码 {{item.roomCode}}</text>
      <text class="status-pill status-{{item.status}}">{{item.status === 'revealed' ? '已开奖' : '品评中'}}</text>
    </view>
    <view class="r-name">{{item.name}}</view>
    <view class="r-desc">{{item.sampleCount}} 款酒 · {{item.description}}</view>
  </view>
</view>
