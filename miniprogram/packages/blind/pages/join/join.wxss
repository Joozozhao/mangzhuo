.form-page .page-title { color: #274d3b; }
.form-page .profile-hint { display: block; width: 100%; margin: 0 0 28rpx; padding: 20rpx 24rpx; border: 1rpx solid #ccd4c4; border-radius: 14rpx; background: #eef1e8; color: #374c3d; text-align: left; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
.form-page .code-box { padding: 40rpx 28rpx; margin-bottom: 40rpx; text-align: center; }
.code-title { display: block; margin-bottom: 24rpx; color: #374c3d; font-size: 16px; font-weight: 600; line-height: 1.6; }
.code-input-wrap { display: flex; justify-content: center; width: 100%; min-width: 0; }
.form-page .code-input { box-sizing: border-box; width: 100%; max-width: 400rpx; min-width: 0; min-height: 56px; height: 120rpx; margin: 0; padding: 0 16rpx 0 28rpx; border: 1rpx solid #b4c0ad; border-radius: 14rpx; background: #fbfaf5; color: #274d3b; font-size: 28px; font-weight: 600; letter-spacing: 12rpx; text-align: center; }
.code-hint { margin: 16rpx 0 28rpx; color: #657160; font-size: 12px; line-height: 1.7; }
.section-title { margin-bottom: 20rpx; color: #274d3b; font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 34rpx; font-weight: 500; line-height: 1.6; }
.form-page button.room-card { display: block; width: 100%; min-width: 0; margin: 0 0 20rpx; padding: 28rpx; border: 1rpx solid #d6ddcf; background: #fffdf8; color: #28382e; text-align: left; line-height: 1.6; overflow-wrap: anywhere; }
.r-top { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12rpx; margin-bottom: 16rpx; }
.form-page .gold-badge { max-width: 100%; background: #eef1e8; color: #274d3b; border-radius: 12rpx; font-size: 12px; line-height: 1.6; }
.status-pill { padding: 6rpx 14rpx; border-radius: 12rpx; background: #f0f2e9; color: #657160; font-size: 12px; line-height: 1.6; }
.r-name { margin-bottom: 8rpx; color: #274d3b; font-size: 17px; font-weight: 600; line-height: 1.6; overflow-wrap: anywhere; word-break: break-all; }
.r-desc, .room-empty { color: #657160; font-size: 13px; line-height: 1.8; overflow-wrap: anywhere; word-break: break-all; }
.room-empty { padding: 24rpx 0; }
