.code-box { text-align: center; padding: 48rpx 32rpx; margin-bottom: 40rpx; }
.code-title { font-size: 30rpx; font-weight: 700; color: #181713; margin-bottom: 24rpx; display: block; }
.code-input-wrap { display: flex; justify-content: center; margin-bottom: 36rpx; }
.code-input { width: 360rpx; height: 110rpx; background: #fbf7ee; border: 2rpx solid #a97832; border-radius: 20rpx; font-size: 54rpx; font-weight: 800; letter-spacing: 16rpx; color: #181713; text-align: center; }
.section-title { font-size: 30rpx; font-weight: 700; margin-bottom: 20rpx; color: #181713; }
.r-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.r-name { font-size: 32rpx; font-weight: 700; margin-bottom: 6rpx; }
.r-desc { font-size: 24rpx; color: #7d766a; }