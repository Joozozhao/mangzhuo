.container { padding-bottom: 80rpx; }
.tab-scroll { white-space: nowrap; margin-bottom: 24rpx; }
.tab-wrap { display: inline-flex; gap: 16rpx; }
.sample-tab { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 140rpx; height: 110rpx; background: #fffdf8; border: 1.5rpx solid #ded6c9; border-radius: 18rpx; }
.sample-tab.active { background: #171714; color: #fff; border-color: #171714; }
.t-num { font-size: 28rpx; font-weight: 700; }
.t-state { font-size: 20rpx; color: #888174; margin-top: 4rpx; }
.sample-tab.active .t-state { color: #d6b06a; }
.card-head { font-size: 26rpx; font-weight: 700; color: #38342c; margin-bottom: 24rpx; padding-bottom: 16rpx; border-bottom: 1rpx solid #ede4d3; }
.form-item { margin-bottom: 26rpx; position: relative; }
.form-label { font-size: 26rpx; font-weight: 600; color: #38342b; margin-bottom: 12rpx; display: block; }
.suggestion-box { margin-top: 14rpx; background: #fbf7ee; border: 1.5rpx solid #d7b36d; border-radius: 16rpx; padding: 14rpx 18rpx; box-shadow: 0 6rpx 20rpx rgba(169, 120, 50, 0.1); }
.sug-header { font-size: 20rpx; color: #8c5d1e; font-weight: 700; margin-bottom: 8rpx; }
.sug-item { display: flex; align-items: center; justify-content: space-between; padding: 12rpx 10rpx; border-bottom: 1rpx solid #ede3cf; }
.sug-item:last-child { border-bottom: none; }
.sug-left { display: flex; flex-direction: column; }
.sug-brand { font-size: 26rpx; font-weight: 700; color: #181713; }
.sug-product { font-size: 22rpx; color: #756d5f; }
.sug-pill { font-size: 20rpx; background: #f4ebd9; color: #8c5d1e; padding: 4rpx 12rpx; border-radius: 8rpx; font-weight: 600; }
.tag-grid { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { padding: 12rpx 22rpx; border-radius: 14rpx; background: #fbf7ee; border: 1rpx solid #ded6c9; font-size: 24rpx; color: #4b453a; }
.tag.active { background: #a97832; color: #fff; border-color: #a97832; }
.form-row { display: flex; gap: 20rpx; margin-bottom: 26rpx; }
.form-row .col { flex: 1; }
.btn-stack { display: flex; flex-direction: column; gap: 20rpx; margin-top: 30rpx; }
.sample-photo-editor { background: #fbf7ee; border: 1rpx solid #e6dfd3; border-radius: 12rpx; padding: 20rpx; }
.photo-empty { color: #897b68; font-size: 25rpx; padding: 22rpx 0; text-align: center; }
.sample-photo-image { display: block; width: 100%; height: 360rpx; border-radius: 8rpx; background: #eee7dc; }
.photo-actions { display: flex; gap: 20rpx; margin-top: 20rpx; }
.photo-btn { flex: 1; height: 80rpx; line-height: 80rpx; font-size: 26rpx; margin: 0; padding: 0 12rpx; }
.photo-remove { background: transparent; color: #893e32; font-size: 24rpx; text-align: right; margin: 8rpx 0 0; padding: 10rpx 0; line-height: 1.5; }
.photo-hint { font-size: 22rpx; color: #897b68; line-height: 1.6; margin-top: 12rpx; }
