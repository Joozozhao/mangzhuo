{
  "__usePrivacyCheck__": true,
  "pages": [
    "pages/index/index",
    "pages/gather/gather",
    "pages/knowledge/knowledge",
    "pages/mine/mine",
    "pages/profile/profile",
    "pages/checkin/checkin",
    "pages/card/card",
    "pages/about/about",
    "pages/member-level/member-level"
  ],
  "subpackages": [
    {
      "root": "packages/blind",
      "pages": [
        "pages/create/create",
        "pages/setup/setup",
        "pages/join/join",
        "pages/room/room",
        "pages/tasting/tasting",
