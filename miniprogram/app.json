      },
      {
        "pagePath": "pages/knowledge/knowledge",
        "text": "酒识",
        "iconPath": "assets/brand/tab-knowledge.png",
        "selectedIconPath": "assets/brand/tab-knowledge.png"
      },
      {
        "pagePath": "pages/mine/mine",
