.mode-tabs{display:flex;border-bottom:1rpx solid #d6ddcf;margin:0 0 36rpx;}
.organized-page button.mode-tab{flex:1;width:50%;min-width:0;min-height:48px;margin:0;padding:18rpx 8rpx;background:transparent;border-bottom:3rpx solid transparent;border-radius:0;font-size:16px;color:#687365;white-space:nowrap;}
.organized-page button.mode-tab.active{border-bottom-color:#274d3b;color:#274d3b;background:transparent;}
.ink-block{background:#274d3b;color:#f7f6ef;padding:34rpx 40rpx 40rpx;}
.ink-kicker{display:flex;align-items:center;justify-content:space-between;gap:12rpx;color:#d3ddcb;font-size:12px;letter-spacing:1rpx;}
.ink-title{font-family:"Songti SC","STSong","SimSun",serif;font-size:56rpx;line-height:1.55;font-weight:400;margin:26rpx 0 20rpx;letter-spacing:3rpx;}
.ink-description{font-size:14px;line-height:1.9;color:#e1e8d9;margin-bottom:36rpx;}
.journal.organized-page .ink-block .ink-action{background:#f7f6ef;color:#274d3b;border-color:#f7f6ef;}
.tasting-steps{display:flex;justify-content:space-between;gap:12rpx;font-family:"Songti SC","STSong",serif;color:#687365;padding:30rpx 0;border-bottom:1rpx solid #d6ddcf;font-size:12px;}
.gather-page .join-entry{border-bottom:1rpx solid #d6ddcf;}
.gather-page .demo-entry{padding:26rpx 0;}
.demo-title{font-family:"Songti SC","STSong",serif;font-size:18px;color:#28382e;}
.organized-page button.room-entry{display:block;width:100%;margin:0;padding:28rpx 0;background:transparent;border-bottom:1rpx solid #dfe3d9;text-align:left;border-radius:0;}
.room-title-line{display:flex;align-items:flex-start;justify-content:space-between;gap:18rpx;}
.room-title-line .row-title{flex:1;min-width:0;margin:0;}
.room-status{flex-shrink:0;color:#274d3b;border:1rpx solid #c8d3be;padding:3rpx 10rpx;font-size:12px;background:#e9ede3;}
.status-done{color:#687365;background:transparent;border-color:#d6ddcf;}
.organized-page .room-description{font-size:14px;margin-top:12rpx;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.room-summary{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:18rpx;font-size:12px;color:#687365;}
.room-link{color:#274d3b;flex-shrink:0;}
.join-by-id{padding-top:30rpx;margin-top:8rpx;}
.join-id-label{font-size:14px;color:#4c5c4b;margin-bottom:18rpx;}
.join-id-row{display:flex;align-items:stretch;gap:14rpx;}
.join-id-input{flex:1;min-width:0;width:0;min-height:48px;height:92rpx;padding:0 20rpx;box-sizing:border-box;}
.journal.organized-page button.join-id-btn{width:112rpx;min-width:60px;flex:0 0 112rpx;margin:0;padding:0;}
.online-tags{display:flex;align-items:center;gap:10rpx;flex-wrap:wrap;justify-content:flex-end;}
.owner-badge{font-size:12px;color:#274d3b;}
.list-tail{font-size:12px;color:#687365;text-align:center;padding:24rpx 0;}
@media(max-width:350px){.ink-block{padding:30rpx;}.ink-title{font-size:60rpx;}.room-title-line{flex-wrap:wrap;}.online-tags{justify-content:flex-start;}}
