.mode-tabs{display:flex;padding:6rpx;background:#eee7dc;border-radius:12rpx;gap:4rpx;}
.organized-page button.mode-tab{flex:1;min-width:0;min-height:44px;margin:0;padding:16rpx 8rpx;background:transparent;color:#6c5d4c;font-size:26rpx;line-height:1.4;border-radius:8rpx;white-space:nowrap;}
.organized-page button.mode-tab.active{background:#fffdf8;color:#893e32;font-weight:600;}
.mode-explanation{font-size:23rpx;line-height:1.65;color:#746653;margin:16rpx 0 20rpx;}
.gather-actions{display:flex;gap:16rpx;}
.organized-page .gather-actions button{flex:1;min-width:0;margin:0;font-size:25rpx;padding:0 8rpx;}
.organized-page .gather-start .inline-action{margin-top:16rpx;border-top:1rpx solid #e7dfd3;padding-bottom:0;}
.organized-page button.room-entry{display:block;width:100%;margin:0;background:transparent;padding:24rpx 0;border-bottom:1rpx solid #e7dfd3;line-height:1.5;text-align:left;white-space:normal;border-radius:0;}
.organized-page button.room-entry:last-child{border-bottom:0;padding-bottom:4rpx;}
.room-title-line{display:flex;align-items:flex-start;justify-content:space-between;gap:16rpx;}
.room-title-line .row-title{flex:1;min-width:0;margin:0;}
.room-meta{display:flex;justify-content:space-between;align-items:center;gap:12rpx;font-size:22rpx;}
.room-code{color:#746653;}
.room-status{color:#893e32;background:#f2e3da;padding:4rpx 12rpx;border-radius:6rpx;flex-shrink:0;}
.status-done{color:#655640;background:#ede6d8;}
.organized-page .room-description{font-size:23rpx;display:-webkit-box;-webkit-line-clamp:1;-webkit-box-orient:vertical;overflow:hidden;margin-top:8rpx;}
.room-summary{display:flex;justify-content:space-between;align-items:center;gap:12rpx;margin-top:14rpx;font-size:22rpx;color:#746653;flex-wrap:wrap;}
.room-link{color:#893e32;flex-shrink:0;}
.login-guide .guide-title{font-size:27rpx;font-weight:600;margin-bottom:8rpx;}
.login-guide .btn-primary{margin-top:24rpx;}
.join-by-id{padding-top:22rpx;border-top:1rpx solid #e7dfd3;margin-top:24rpx;}
.join-id-label{font-size:23rpx;color:#746653;margin-bottom:14rpx;}
.join-id-row{display:flex;gap:16rpx;align-items:stretch;}
.join-id-input{flex:1;min-width:0;width:0;height:88rpx;min-height:44px;padding:0 20rpx;background:#f7f3eb;border:1rpx solid #ded2bf;border-radius:12rpx;font-size:26rpx;box-sizing:border-box;}
.organized-page button.join-id-btn{width:128rpx;flex:0 0 128rpx;margin:0;padding:0;}
.online-tags{display:flex;align-items:center;gap:12rpx;}
.owner-badge{font-size:20rpx;color:#893e32;}
.list-tail{font-size:22rpx;color:#746653;text-align:center;padding-top:24rpx;}
