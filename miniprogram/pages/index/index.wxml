<brand-nav/>
<view class="journal organized-page home-page">
  <view class="content-panel home-start">
    <view class="page-kicker"><text>品 鉴 手 记</text><text class="chapter-number">第一章 · 记</text></view>
    <view class="chapter-hero-banner home-hero">
      <image class="chapter-title-svg home-title-svg" src="/assets/brand/home-hero-title.svg" mode="aspectFit" aria-label="记下这一杯，先写感受，最后揭晓"/>
      <image class="chapter-pose-svg home-pose-svg" src="/assets/brand/libai-home.svg" mode="aspectFit" aria-label="李白闻香，盲酌品牌插画"/>
    </view>
    <view class="home-description">记酒款，记风味，也记相聚。</view>
    <button class="btn-primary" bindtap="checkin"><text>记一杯</text><text class="button-arrow" aria-hidden="true">＋</text></button>
    <button class="share-ticket" bindtap="shareLatest" aria-label="制作分享酒卡">
      <view class="share-stub">
        <text class="share-stub-mark">酒卡</text>
      </view>
      <view class="share-body">
        <view class="share-title">制作分享酒卡</view>
        <view class="share-desc">把最近一次品鉴，留在一张纸签里</view>
      </view>
      <view class="share-open"><image class="ledger-chevron" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></view>
    </button>
  </view>
  <view class="content-panel record-panel">
    <view class="panel-heading notes-heading">
      <view class="panel-title">最近手记</view>
      <button class="mine-link-pill" bindtap="mine"><text>全部手记</text><image class="small-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    </view>
    <view class="note-ledger" wx:if="{{notes.length}}">
      <button class="ledger-row" wx:for="{{notes}}" wx:key="id" bindtap="openNote" data-id="{{item.id}}" aria-label="{{item.dateLabel}}，{{item.aromaType}}，{{item.title}}，查看手记">
        <view class="ledger-date">
          <text class="date-month-day">{{item.dateMonthDay}}</text>
          <text wx:if="{{item.dateYear}}" class="date-year">{{item.dateYear}}</text>
        </view>
        <view class="ledger-copy">
          <view class="note-aroma">{{item.aromaType}}</view>
          <view class="note-title">{{item.title}}</view>
          <view class="note-excerpt">{{item.note || '打开手记，回顾这一杯的风味。'}}</view>
        </view>
        <view class="ledger-open"><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
      </button>
    </view>
    <view wx:else class="empty-ledger">
      <view class="empty-ledger-title">第一杯，值得留一页</view>
      <view class="muted">写下真实的感受，慢慢认识自己的口味。</view>
      <button class="mine-checkin empty-checkin" bindtap="checkin"><text>写下第一篇</text><image class="small-arrow light-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    </view>
  </view>
  <view class="quiet-footer">少量品鉴 · 理性饮酒 · 未成年人请勿饮酒</view>
</view>
