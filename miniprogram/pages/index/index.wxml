<brand-nav/>
<view class="journal organized-page home-page">
  <view class="content-panel home-start">
    <view class="page-kicker"><text>品 鉴 手 记</text><text class="chapter-number">第一章 · 记</text></view>
    <view class="home-hero">
      <view class="home-title" aria-label="记下这一杯"><view class="title-column"><text>记</text><text>下</text></view><view class="title-column"><text>这</text><text>一</text><text>杯</text></view></view>
      <view class="vertical-note"><text>先</text><text>写</text><text>感</text><text>受</text><text>，</text><text>最</text><text>后</text><text>揭</text><text>晓</text></view>
      <image class="home-art bamboo-art" src="/assets/brand/libai-home.png" mode="aspectFit" aria-label="李白举杯，盲酌品牌插画"/>
    </view>
    <view class="home-description">记酒款，记风味，也记相聚。</view>
    <button class="btn-primary" bindtap="checkin"><text>记一杯</text><text class="button-arrow" aria-hidden="true">＋</text></button>
    <button class="inline-action share-latest" bindtap="shareLatest"><text>制作分享酒卡</text><text class="action-arrow" aria-hidden="true">↗</text></button>
  </view>
  <view class="content-panel record-panel">
    <view class="panel-heading"><view class="panel-title">最近手记</view><button class="text-link" bindtap="mine">全部手记 ↗</button></view>
    <button class="record-row" wx:for="{{notes}}" wx:key="id" bindtap="openNote" data-id="{{item.id}}">
      <text class="record-number">{{index > 8 ? index + 1 : '0' + (index + 1)}}</text>
      <view class="record-body"><view class="row-title">{{item.title}}</view><view class="meta">{{item.aromaType}} · {{item.date}}</view></view>
      <text class="record-arrow" aria-hidden="true">↗</text>
    </button>
    <view wx:if="{{!notes.length}}" class="panel-empty"><view class="row-title">第一杯，值得留一页</view><view class="muted">写下真实的感受，慢慢认识自己的口味。</view><button class="text-link" bindtap="checkin">写下第一篇 ↗</button></view>
  </view>
  <view class="quiet-footer">少量品鉴 · 理性饮酒 · 未成年人请勿饮酒</view>
</view>
