.home-page .home-start{margin-bottom:48rpx;}
.home-hero{min-height:380rpx;margin-top:8rpx;}
.home-title-svg{width:372rpx;height:330rpx;}
.home-pose-svg{right:-52rpx;bottom:4rpx;width:392rpx;height:392rpx;}
.home-description{font-size:14px;color:#4c5c4b;line-height:1.8;margin:28rpx 0 30rpx;}
.journal.organized-page .share-ticket{display:flex;align-items:stretch;width:100% !important;min-height:142rpx;margin:22rpx 0 0;padding:0;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;text-align:left;overflow:visible;}
.share-stub{position:relative;display:flex;flex:0 0 132rpx;align-items:center;justify-content:center;padding:18rpx 8rpx;background:#e5eadb;border-right:1rpx dashed #bac5b0;border-radius:11rpx 0 0 11rpx;}
.share-stub::before,.share-stub::after{content:"";position:absolute;right:-14rpx;width:24rpx;height:24rpx;border:1rpx solid #b9c5b1;border-radius:50%;background:#f7f6ef;z-index:1;}
.share-stub::before{top:-13rpx;border-top-color:transparent;border-left-color:transparent;transform:rotate(45deg);}
.share-stub::after{bottom:-13rpx;border-bottom-color:transparent;border-right-color:transparent;transform:rotate(45deg);}
.share-stub-mark{font-family:"Songti SC","STSong",serif;font-size:34rpx;font-weight:600;letter-spacing:2rpx;color:#274d3b;}
.share-body{flex:1;min-width:0;padding:22rpx 12rpx 22rpx 24rpx;display:flex;flex-direction:column;justify-content:center;}
.share-title{font-family:"Songti SC","STSong",serif;font-size:34rpx;font-weight:600;line-height:1.4;color:#28382e;}
.share-desc{margin-top:6rpx;font-size:12px;line-height:1.6;color:#687365;}
.share-open{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;}
.home-page .record-panel{margin:0 -12rpx 34rpx;}
.home-page .notes-heading{align-items:center;gap:18rpx;min-height:44px;margin:0 0 24rpx;padding:0;border:0;}
.home-page .notes-heading .panel-title{font-size:52rpx;font-weight:600;line-height:1.35;letter-spacing:1rpx;}
.journal.organized-page .mine-link-pill{display:flex;align-items:center;justify-content:center;gap:8rpx;flex-shrink:0;width:auto !important;min-height:44px;margin:0;padding:8rpx 22rpx;border:1rpx solid #b9c5b1;border-radius:40rpx;background:#fbfaf5;color:#274d3b;font-size:13px;font-weight:500;line-height:1.5;}
.small-arrow{display:block;width:28rpx;height:28rpx;flex-shrink:0;}
.light-arrow{filter:brightness(0) invert(1);}
.note-ledger{position:relative;border:1rpx solid #b9c5b1;border-radius:12rpx;background:#fbfaf5;}
.note-ledger::before,.note-ledger::after{content:"";position:absolute;left:138rpx;width:26rpx;height:26rpx;border:1rpx solid #b9c5b1;border-radius:50%;background:#f7f6ef;z-index:1;}
.note-ledger::before{top:-14rpx;border-top-color:transparent;border-left-color:transparent;transform:rotate(45deg);}
.note-ledger::after{bottom:-14rpx;border-bottom-color:transparent;border-right-color:transparent;transform:rotate(45deg);}
.journal.organized-page .ledger-row{display:flex;align-items:stretch;width:100% !important;max-width:none;min-width:0;min-height:190rpx;margin:0;padding:0;background:transparent;border-radius:0;text-align:left;}
.ledger-row:first-child{border-radius:11rpx 11rpx 0 0;}
.ledger-row:last-child{border-radius:0 0 11rpx 11rpx;}
.ledger-row+.ledger-row{border-top:1rpx solid #cbd3c2;}
.ledger-date{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 152rpx;min-width:0;gap:8rpx;padding:24rpx 6rpx;background:#e5eadb;border-right:1rpx dashed #bac5b0;}
.ledger-row:first-child .ledger-date{border-top-left-radius:11rpx;}
.ledger-row:last-child .ledger-date{border-bottom-left-radius:11rpx;}
.date-month-day{max-width:100%;font-family:Georgia,"Times New Roman",serif;font-size:36rpx;font-weight:600;line-height:1.3;color:#274d3b;overflow-wrap:anywhere;}
.date-year{font-family:Georgia,"Times New Roman",serif;font-size:13px;line-height:1.4;color:#687365;}
.ledger-copy{flex:1;min-width:0;padding:24rpx 0 24rpx 26rpx;}
.note-aroma{font-size:12px;line-height:1.6;color:#687365;overflow-wrap:anywhere;}
.note-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:6rpx;font-family:"Songti SC","STSong","SimSun",serif;font-size:42rpx;font-weight:500;line-height:1.4;color:#28382e;overflow-wrap:anywhere;}
.note-excerpt{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:10rpx;font-size:13px;line-height:1.7;color:#687365;overflow-wrap:anywhere;}
.ledger-open{display:flex;align-items:center;justify-content:center;flex:0 0 56rpx;}
.ledger-chevron{display:block;width:32rpx;height:32rpx;flex-shrink:0;}
.empty-ledger{padding:30rpx 28rpx;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;}
.empty-ledger-title{font-family:"Songti SC","STSong",serif;font-size:36rpx;line-height:1.5;color:#28382e;margin-bottom:12rpx;}
.journal.organized-page .mine-checkin{display:inline-flex;align-items:center;justify-content:center;gap:10rpx;width:auto !important;min-height:44px;margin:24rpx 0 0;padding:10rpx 24rpx;border:0;border-radius:40rpx;background:#274d3b;color:#f7f6ef;font-size:14px;line-height:1.5;}
@media(max-width:350px){.home-hero{min-height:344rpx;}.home-title-svg{width:320rpx;height:284rpx;}.home-pose-svg{right:-62rpx;width:348rpx;height:348rpx;}.home-page .record-panel{margin-left:0;margin-right:0;}.share-stub{flex-basis:116rpx;}.ledger-date{flex-basis:132rpx;}.note-ledger::before,.note-ledger::after{left:118rpx;}.ledger-copy{padding-left:20rpx;}}
