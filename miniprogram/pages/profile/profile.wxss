.profile-page { padding-top: 38rpx; background: #f7f6ef; }
.profile-header { margin-bottom: 26rpx; }
.profile-kicker { color: #a97832; font-size: 21rpx; letter-spacing: 5rpx; margin-bottom: 18rpx; }
.profile-page .page-title { font-size: 50rpx; font-weight: 500; letter-spacing: 2rpx; line-height: 1.45; }
.profile-page .page-desc { margin-top: 10rpx; font-size: 25rpx; color: #777167; line-height: 1.7; }
.profile-steps { display: flex; align-items: center; margin: 4rpx 0 30rpx; }
.profile-step { display: flex; align-items: center; gap: 12rpx; flex-shrink: 0; color: #a39a8b; font-size: 22rpx; line-height: 1.5; }
.step-index { font-family: Georgia, "Times New Roman", serif; font-size: 25rpx; }
.step-current { color: #274d3b; }
.step-done { color: #a97832; }
.step-line { flex: 1; min-width: 32rpx; height: 1rpx; margin: 0 22rpx; background: #ddd5c8; }
.line-done { background: #c8b185; }
.profile-page .card { padding: 34rpx; margin-bottom: 26rpx; border: 1rpx solid #e0d8c9; border-radius: 12rpx; box-shadow: none; }
.profile-page .identity-needed { background: #274d3b; border-color: #274d3b; color: #fffdf8; }
.profile-page .identity-connected { background: #eef3eb; border-color: #cbd6c7; }
.identity-heading, .editor-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 28rpx; }
.identity-label, .editor-label { min-width: 0; color: #a97832; font-size: 21rpx; letter-spacing: 3rpx; }
.identity-needed .identity-label { color: #d7b36d; }
.identity-status { flex-shrink: 0; color: #687365; font-size: 21rpx; letter-spacing: 2rpx; }
.identity-needed .identity-status { color: #d8dfd5; }
.identity-title { font-size: 34rpx; font-weight: 500; line-height: 1.55; letter-spacing: 1rpx; color: #28382e; }
.identity-needed .identity-title { color: #fffdf8; }
.identity-desc { margin-top: 14rpx; font-size: 23rpx; line-height: 1.8; color: #687365; }
.identity-needed .identity-desc { color: #d8dfd5; }
.profile-page button.identity-action { display: flex; align-items: center; justify-content: space-between; width: 100%; min-height: 92rpx; margin: 30rpx 0 0; padding: 0 28rpx; background: #f4e7ca; color: #274d3b; border: 0; border-radius: 8rpx; font-size: 27rpx; font-weight: 600; line-height: 1.5; text-align: left; }
.identity-arrow { margin-left: 20rpx; font-family: Arial, sans-serif; font-size: 32rpx; font-weight: 400; }
.profile-card { background: #fffdf8; }
.editor-note { flex-shrink: 0; color: #8c7964; font-size: 21rpx; }
.avatar-row { display: flex; align-items: center; gap: 30rpx; margin-bottom: 34rpx; }
.profile-page button.avatar-btn { flex: 0 0 160rpx; width: 160rpx !important; min-width: 160rpx; max-width: 160rpx; height: 160rpx; border-radius: 50%; padding: 0; margin: 0; background: #f4e7ca; border: 2rpx solid #d7b36d; display: flex; align-items: center; justify-content: center; overflow: hidden; line-height: normal; }
.avatar-btn::after, .identity-action::after, .cancel-link::after { border: none; }
.avatar-img { width: 100%; height: 100%; }
.avatar-emoji { font-size: 40rpx; color: #274d3b; letter-spacing: 2rpx; }
.avatar-copy { flex: 1; min-width: 0; }
.avatar-title { color: #28382e; font-size: 30rpx; line-height: 1.5; }
.avatar-tip { margin-top: 10rpx; font-size: 22rpx; color: #777167; line-height: 1.7; }
.avatar-action { margin-top: 12rpx; color: #a97832; font-size: 21rpx; line-height: 1.6; }
.nickname-field { padding-top: 30rpx; border-top: 1rpx solid #e6dfd3; }
.nickname-field .form-label { display: block; color: #28382e; font-size: 27rpx; line-height: 1.5; margin-bottom: 16rpx; }
.profile-page .nickname-input { height: 94rpx; margin-top: 0; background: #fff; border: 1rpx solid #cfc5b5; border-radius: 8rpx; font-size: 28rpx; }
.nickname-tip { font-size: 21rpx; color: #8c7964; margin-top: 14rpx; line-height: 1.7; }
.profile-page .save-btn { height: 96rpx; margin-top: 4rpx; border-radius: 8rpx; font-size: 29rpx; letter-spacing: 2rpx; }
.profile-page .cancel-link { display: flex; align-items: center; justify-content: center; min-height: 88rpx; margin: 12rpx auto 0; background: transparent; font-size: 24rpx; color: #687365; }
.profile-footer { margin-top: 30rpx; color: #a39a8b; font-size: 21rpx; letter-spacing: 2rpx; line-height: 1.8; text-align: center; }
@media (max-width: 350px) {
  .profile-page .card { padding: 28rpx; }
  .avatar-row { gap: 22rpx; }
  .profile-page button.avatar-btn { flex-basis: 140rpx; width: 140rpx !important; min-width: 140rpx; max-width: 140rpx; height: 140rpx; }
  .identity-title { font-size: 31rpx; }
}
