.profile-page {
  width: 100%;
  max-width: 900rpx;
  min-width: 0;
  margin: 0 auto;
  padding: 36rpx 36rpx 80rpx;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  background: #f7f6ef;
}
.profile-header { margin-bottom: 28rpx; }
.profile-kicker { color: #687365; font-size: 12px; letter-spacing: 3rpx; line-height: 1.6; margin-bottom: 14rpx; }
.profile-page .page-title { font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 48rpx; font-weight: 400; letter-spacing: 2rpx; line-height: 1.45; color: #28382e; }
.profile-page .page-desc { margin-top: 12rpx; font-size: 14px; color: #687365; line-height: 1.75; }
.profile-steps { display: flex; align-items: center; margin: 4rpx 0 30rpx; }
.profile-step { display: flex; align-items: center; gap: 10rpx; flex-shrink: 0; color: #687365; font-size: 12px; line-height: 1.6; }
.step-index { font-family: Georgia, "Times New Roman", serif; font-size: 14px; }
.step-current, .step-done { color: #274d3b; }
.step-line { flex: 1; min-width: 16rpx; height: 1rpx; margin: 0 18rpx; background: #d6ddcf; }
.line-done { background: #a7b79d; }
.profile-page .card { min-width: 0; padding: 30rpx; margin-bottom: 24rpx; border: 1rpx solid #d6ddcf; border-radius: 16rpx; box-shadow: none; }
.profile-page .identity-needed { background: #274d3b; border-color: #274d3b; color: #fffdf8; }
.profile-page .identity-connected { background: #edf1e7; border-color: #cbd6c7; }
.identity-heading, .editor-heading { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12rpx 20rpx; margin-bottom: 24rpx; line-height: 1.6; }
.identity-label, .editor-label { min-width: 0; color: #52654c; font-size: 12px; letter-spacing: 2rpx; }
.identity-needed .identity-label { color: #f0dfb8; }
.identity-status { flex-shrink: 0; color: #52654c; font-size: 12px; }
.identity-needed .identity-status { color: #e1e8db; }
.identity-title { font-size: 17px; font-weight: 500; line-height: 1.6; color: #28382e; }
.identity-needed .identity-title { color: #fffdf8; }
.identity-desc { margin-top: 14rpx; font-size: 14px; line-height: 1.8; color: #52654c; }
.identity-needed .identity-desc { color: #e1e8db; }
.profile-page button.identity-action { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-width: 0; min-height: 48px; height: auto; margin: 26rpx 0 0; padding: 20rpx 24rpx; background: #f4e7ca; color: #274d3b; border: 0; border-radius: 12rpx; font-size: 16px; font-weight: 500; line-height: 1.5; white-space: normal; text-align: left; }
.identity-action > text:first-child { flex: 1; min-width: 0; }
.identity-arrow { flex-shrink: 0; font-size: 22px; font-weight: 400; }
.profile-card { background: #fffdf8; }
.editor-note { color: #687365; font-size: 12px; }
.profile-page button.avatar-picker { display: flex; align-items: center; gap: 24rpx; width: 100%; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 0 0 28rpx; border: 0; border-radius: 0; background: transparent; color: #28382e; line-height: 1.6; white-space: normal; text-align: left; }
.avatar-frame { flex: 0 0 120rpx; width: 120rpx; height: 120rpx; min-width: 52px; min-height: 52px; border: 1rpx solid #cbd6c7; border-radius: 50%; background: #edf1e7; display: flex; align-items: center; justify-content: center; overflow: hidden; }
.avatar-img { display: block; width: 100%; height: 100%; }
.avatar-emoji { font-size: 36rpx; color: #274d3b; }
.avatar-copy { flex: 1; min-width: 0; }
.avatar-title { color: #28382e; font-size: 16px; line-height: 1.5; }
.avatar-tip { margin-top: 8rpx; font-size: 12px; color: #687365; line-height: 1.75; }
.avatar-action { margin-top: 10rpx; color: #274d3b; font-size: 13px; line-height: 1.6; }
.nickname-field { padding-top: 26rpx; border-top: 1rpx solid #dfe3d9; }
.nickname-field .form-label { display: block; color: #28382e; font-size: 14px; line-height: 1.6; margin-bottom: 14rpx; }
.profile-page .nickname-input { min-width: 0; height: 48px; min-height: 44px; margin-top: 0; padding: 0 22rpx; background: #fbfaf5; border: 1rpx solid #b4c0ad; border-radius: 12rpx; font-size: 16px; }
.nickname-tip { font-size: 12px; color: #687365; margin-top: 14rpx; line-height: 1.75; }
.profile-page .save-btn { width: 100%; min-height: 48px; height: auto; margin: 4rpx 0 0; padding: 22rpx 24rpx; border-radius: 14rpx; font-size: 16px; letter-spacing: 0; line-height: 1.5; white-space: normal; }
.profile-page .cancel-link { display: flex; align-items: center; justify-content: center; min-height: 44px; height: auto; width: 100%; margin: 12rpx 0 0; padding: 16rpx 24rpx; background: transparent; font-size: 14px; color: #52654c; line-height: 1.6; white-space: normal; }
.profile-footer { margin-top: 24rpx; color: #687365; font-size: 12px; line-height: 1.8; text-align: center; }
.identity-title, .identity-desc, .avatar-copy, .nickname-tip, .profile-footer { overflow-wrap: anywhere; word-break: break-all; }
@media (max-width: 350px) {
  .profile-page { padding-left: 28rpx; padding-right: 28rpx; }
  .profile-page .card { padding: 26rpx; }
  .profile-page button.avatar-picker { gap: 20rpx; }
  .step-line { margin: 0 12rpx; }
}
