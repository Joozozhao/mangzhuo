.profile-page .page-header { margin-bottom: 28rpx; }

.profile-card { padding: 32rpx; margin-bottom: 24rpx; }

.avatar-row { display: flex; align-items: center; margin-bottom: 28rpx; }

.avatar-btn {
  flex: 0 0 128rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0 24rpx 0 0;
  background: #f4e7ca;
  border: 2rpx dashed #d7b36d;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  line-height: normal;
}
.profile-page button.avatar-btn { width: 128rpx !important; min-width: 128rpx; max-width: 128rpx; }
.avatar-btn::after { border: none; }

.avatar-img { width: 100%; height: 100%; }

.avatar-emoji { font-size: 64rpx; }

.avatar-tip { flex: 1; font-size: 22rpx; color: #877f72; line-height: 1.6; }

.nickname-input { margin-top: 12rpx; }

.nickname-tip { font-size: 21rpx; color: #a39a8b; margin-top: 14rpx; line-height: 1.6; }

.identity-card { padding: 28rpx 32rpx; margin-bottom: 36rpx; }

.identity-row { display: flex; align-items: center; justify-content: space-between; }

.identity-title { font-size: 28rpx; font-weight: 700; color: #181713; margin-bottom: 6rpx; }

.identity-state { font-size: 23rpx; color: #9c9486; }
.identity-state.state-ok { color: #2e8b57; font-weight: 600; }

.login-btn {
  margin: 0;
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #274d3b;
  background: #f7f6ef;
  border: 1rpx solid #ccd4c4;
  border-radius: 12rpx;
  line-height: 1.6;
}
.login-btn::after { border: none; }

.identity-tip {
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx dashed #ebdcc6;
  font-size: 21rpx;
  color: #a97832;
  line-height: 1.6;
}

.cancel-link {
  display: block;
  margin: 24rpx auto 0;
  background: transparent;
  font-size: 24rpx;
  color: #274d3b;
}
.cancel-link::after { border: none; }
