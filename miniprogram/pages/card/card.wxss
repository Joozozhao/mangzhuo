/* 分享酒卡：酒卡是主角，保存和分享集中在同一操作区。 */
.card-page .card-heading { margin: 12rpx 0 28rpx; }
.card-page .card-kicker { color: #687365; font-size: 12px; letter-spacing: 3rpx; line-height: 1.6; margin-bottom: 14rpx; }
.card-page .heading-desc { font-size: 14px; color: #687365; line-height: 1.8; margin-top: 12rpx; }
.journal.organized-page .card-profile-hint { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; width: 100%; min-width: 0; min-height: 44px; margin: 0 0 28rpx; padding: 20rpx 24rpx; border: 1rpx solid #b9c5b1; border-radius: 12rpx; background: #edf0e7; color: #274d3b; font-size: 14px; line-height: 1.7; text-align: left; }
.preview-panel { padding: 32rpx 36rpx 36rpx; margin-bottom: 28rpx; background: #e5eadb; border: 1rpx solid #b9c5b1; border-radius: 12rpx; }
.preview-heading { display: flex; align-items: center; justify-content: space-between; gap: 18rpx; margin-bottom: 24rpx; color: #274d3b; font-size: 14px; line-height: 1.6; }
.preview-hint { flex-shrink: 0; color: #687365; font-size: 12px; }
.journal.organized-page .poster-preview-button { display: block; width: 100%; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 0; background: #fbfaf5; border: 1rpx solid #b9c5b1; border-radius: 8rpx; line-height: 0; overflow: hidden; }
.poster-image { display: block; width: 100%; background: #fbfaf5; }
.poster-canvas { position: fixed; left: -2000px; top: 0; width: 750px; height: 1200px; pointer-events: none; }
.card-placeholder { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 24rpx; min-height: 520rpx; padding: 48rpx 28rpx; border: 1rpx dashed #b9c5b1; border-radius: 8rpx; background: #fbfaf5; color: #687365; font-size: 14px; line-height: 1.8; text-align: center; }
.loading-mark { width: 36rpx; height: 36rpx; border: 2rpx solid #b9c5b1; border-top-color: #274d3b; border-radius: 50%; animation: card-spin .9s linear infinite; }
.journal.organized-page .retry-button { display: flex; align-items: center; justify-content: center; width: auto; min-height: 44px; padding: 10rpx 32rpx; margin: 0; background: #274d3b; border: 0; border-radius: 8rpx; color: #fbfaf5; font-size: 14px; }
.share-panel { padding: 28rpx; margin-bottom: 32rpx; border: 1rpx solid #b9c5b1; border-radius: 12rpx; background: #fbfaf5; }
.share-caption { margin-bottom: 20rpx; color: #28382e; font-family: "Songti SC", "STSong", serif; font-size: 17px; line-height: 1.6; }
.card-actions { display: flex; gap: 16rpx; }
.journal.organized-page .card-actions button { flex: 1; justify-content: center; width: auto; min-width: 0; min-height: 48px; height: auto; margin: 0; padding: 22rpx 16rpx; border-radius: 8rpx; font-size: 16px; line-height: 1.5; white-space: normal; }
.card-action-note { margin-top: 16rpx; color: #687365; font-size: 12px; line-height: 1.8; }
.note-detail { padding: 28rpx 0 4rpx; border-top: 1rpx solid #d6ddcf; }
.detail-title-row { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12rpx 20rpx; }
.detail-title { min-width: 0; font-family: "Songti SC", "STSong", serif; font-size: 36rpx; color: #28382e; line-height: 1.5; overflow-wrap: anywhere; }
.detail-date { flex-shrink: 0; font-family: Georgia, serif; font-size: 13px; color: #687365; }
.detail-tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin: 16rpx 0 24rpx; }
.detail-tag { padding: 4rpx 14rpx; border-radius: 6rpx; background: #e5eadb; color: #274d3b; font-size: 12px; }
.taste-row { display: flex; align-items: flex-start; gap: 20rpx; padding: 18rpx 0; border-top: 1rpx solid #dfe3d9; }
.taste-label { flex: 0 0 64rpx; color: #687365; font-size: 13px; line-height: 1.8; }
.taste-copy { flex: 1; min-width: 0; color: #28382e; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
.note-memory { margin-top: 20rpx; padding: 20rpx 24rpx; border-left: 3rpx solid #a8382b; background: #f0f2e9; color: #52654c; font-size: 14px; line-height: 1.8; overflow-wrap: anywhere; }
.card-footer-note { margin-top: 24rpx; color: #687365; font-size: 12px; line-height: 1.8; }
.journal.organized-page .empty-state { padding: 48rpx 28rpx; margin: 32rpx 0; border: 1rpx dashed #b9c5b1; border-radius: 12rpx; background: #fbfaf5; }
.journal.organized-page .empty-title { margin: 0 0 16rpx; color: #28382e; font-size: 18px; font-weight: 500; }
.journal.organized-page .empty-desc { margin: 0 0 28rpx; color: #687365; font-size: 14px; }
@media (max-width: 350px) { .preview-panel { padding: 24rpx; } .preview-hint { font-size: 11px; } .journal.organized-page .card-actions button { padding-left: 10rpx; padding-right: 10rpx; font-size: 15px; } }
@keyframes card-spin { to { transform: rotate(360deg); } }
@media (prefers-reduced-motion: reduce) { .loading-mark { animation: none; } }
