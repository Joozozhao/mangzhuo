.journal.card-page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;padding-top:32rpx;padding-bottom:calc(80rpx + env(safe-area-inset-bottom));color:#28382e;}
.card-heading{margin-bottom:24rpx;}
.card-kicker{font-size:22rpx;letter-spacing:2rpx;color:#274d3b;margin-bottom:12rpx;}
.card-page .page-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;font-weight:400;line-height:1.45;}
.card-description,.card-action-note{font-size:14px;color:#687365;line-height:1.8;}
.card-description{margin-top:8rpx;}
.card-actions{display:flex;gap:16rpx;}
.card-page .card-actions button{flex:1;min-width:0;width:auto;margin:0;padding:22rpx 16rpx;letter-spacing:0;font-size:16px;}
.card-action-note{margin:14rpx 0 26rpx;font-size:22rpx;}
.card-profile-hint{width:100%;min-height:44px;margin:0 0 20rpx;padding:16rpx 20rpx;background:#e9ede3;border:1rpx solid #d6ddcf;border-radius:12rpx;color:#274d3b;font-size:23rpx;line-height:1.5;text-align:left;white-space:normal;}
.preview-heading{display:flex;justify-content:space-between;align-items:center;padding:18rpx 0;border-top:1rpx solid #d6ddcf;font-size:26rpx;font-weight:600;}
.preview-hint{font-size:22rpx;font-weight:400;color:#897b68;}
.poster-canvas{position:fixed;left:-2000px;top:0;width:375px;height:600px;}
.poster-image{display:block;width:100%;border:1rpx solid #ded6c9;background:#f7f6ef;}
.card-placeholder{padding:64rpx 20rpx;text-align:center;background:#e9ede3;color:#706456;font-size:25rpx;line-height:1.6;}
.card-page .card-home{display:flex;align-items:center;justify-content:center;min-height:44px;margin:16rpx auto 0;}
