<brand-nav />
<view class="journal organized-page knowledge-page {{selected || selectedWine ? 'is-reading' : ''}}">
  <block wx:if="{{selected ? false : !selectedWine}}">
    <view class="page-kicker"><text>杯 中 自 有 天 地</text><text class="chapter-number">第三章 · 识</text></view>
    <view class="chapter-hero-banner knowledge-hero">
      <image class="chapter-title-svg" src="/assets/brand/knowledge-hero-title.svg" mode="aspectFit" aria-label="一卷酒识，一杯见识，先认香型，再记风味"/>
      <image class="chapter-pose-svg" src="/assets/brand/libai-knowledge.svg" mode="aspectFit" aria-label="李白展卷读书，盲酌品牌插画"/>
    </view>
    <view class="content-panel knowledge-controls">
      <view class="knowledge-map">
        <button wx:for="{{sections}}" wx:key="id" class="map-row {{section === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchSection" aria-pressed="{{section === item.id}}"><view class="map-name">{{item.shortTitle || item.title}}</view></button>
        <button class="map-row {{section === 'articles' ? 'active' : ''}}" bindtap="openArticles" aria-pressed="{{section === 'articles'}}"><view class="map-name">慢读文章</view></button>
      </view>
      <view class="search-wrap"><input class="input search" placeholder="搜{{activeSection.title}}中的内容" aria-label="搜索{{activeSection.title}}" value="{{query}}" bindinput="search" confirm-type="search"/><button class="search-clear" wx:if="{{query}}" bindtap="clearSearch" aria-label="清除搜索"><text>清除</text></button></view>
      <button class="resume-ticket" wx:if="{{lastRead}}" bindtap="openLastRead" aria-label="继续阅读 {{lastRead.title}}">
        <view class="resume-stub">
          <text class="resume-stub-mark">续读</text>
        </view>
        <view class="resume-main">
          <view class="resume-kicker">{{lastRead.category || '上次读到'}}</view>
          <view class="resume-title">{{lastRead.title}}</view>
        </view>
        <view class="resume-open"><image class="ledger-chevron" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></view>
      </button>
    </view>
    <view wx:if="{{section === 'brands'}}" class="content-panel catalog-panel">
      <view class="panel-heading results-heading"><view class="panel-title">酒款目录</view><view class="meta">{{catalogWines.length}} 款</view></view>
      <view class="catalog-feedback"><text wx:if="{{catalogLoading}}">正在更新酒款目录…</text><block wx:elif="{{catalogError}}"><text>{{catalogSource === 'cache' ? '暂用最近目录' : '暂用离线目录'}}</text><button class="catalog-retry" bindtap="retryWineCatalog">重新加载</button></block><text wx:else>按品牌、酒名或香型查找</text></view>
      <view class="wine-ledger" wx:if="{{catalogWines.length}}">
        <button wx:for="{{catalogWines}}" wx:key="index" class="ledger-row catalog-wine-row" data-brand="{{item.brand}}" data-product="{{item.product}}" bindtap="openWine">
          <view class="ledger-stub">
            <text class="stub-index">{{index > 8 ? index + 1 : '0' + (index + 1)}}</text>
            <text class="stub-sub">{{item.aromaType || '酒款'}}</text>
          </view>
          <view class="ledger-copy">
            <view class="note-aroma">{{item.brand}} · {{item.degree}}</view>
            <view class="note-title">{{item.product}}</view>
          </view>
          <view class="ledger-open"><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
        </button>
      </view>
      <view wx:if="{{catalogWines.length ? false : !catalogLoading}}" class="empty-ledger"><view class="muted">暂无匹配酒款，试试其他品牌或酒名。</view></view>
    </view>
    <view class="content-panel knowledge-results">
      <view wx:if="{{section === 'articles' && (remoteLoading || remoteError)}}" class="remote-feedback">
        <text>{{remoteLoading ? '正在加载在线酒文化内容…' : remoteError}}</text>
        <button wx:if="{{remoteError && !remoteLoading}}" class="text-link" bindtap="retryRemoteKnowledge">重试</button>
      </view>
      <view class="category-list" wx:if="{{section === 'articles'}}">
        <button wx:for="{{categories}}" wx:key="*this" class="category-chip {{articleCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="chooseCategory" aria-pressed="{{articleCategory === item}}"><text class="category-label">{{item}}</text></button>
      </view>
      <view class="panel-heading results-heading">
        <view class="panel-title">{{activeSection.title}}</view>
        <view class="meta">{{results.length}} {{section === 'articles' ? '篇' : '条'}}</view>
      </view>
      <view class="knowledge-ledger" wx:if="{{results.length}}">
        <button class="ledger-row article-entry {{index === 0 ? 'featured-entry' : ''}}" wx:for="{{results}}" wx:key="id" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="open">
          <view class="ledger-stub">
            <text class="stub-index">{{index > 8 ? index + 1 : '0' + (index + 1)}}</text>
            <text class="stub-sub">{{item.category || activeSection.shortTitle || '酒识'}}</text>
          </view>
          <view class="ledger-copy">
            <view class="note-aroma">{{item.meta}}</view>
            <view class="note-title">{{item.title}}</view>
            <view class="note-excerpt">{{item.desc}}</view>
          </view>
          <view class="ledger-open"><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
        </button>
      </view>
      <view class="empty-ledger" wx:if="{{!results.length}}">
        <view class="empty-ledger-title">暂时没有找到相关内容</view>
        <view class="muted">试试更短的关键词，或查看本栏目全部内容。</view>
        <button class="text-link empty-action" wx:if="{{query}}" bindtap="clearSearch">清除搜索条件</button>
      </view>
      <button wx:if="{{section === 'articles' && remoteHasMore && !remoteLoading}}" class="text-link remote-more" bindtap="loadRemoteKnowledge">加载更多在线内容</button>
    </view>
    <view class="quiet-footer">酒款资料以实际酒标和酒厂信息为准。</view>
  </block>
  <block wx:elif="{{selected}}">
    <view class="content-panel article-detail">
      <button class="text-link" bindtap="close">← 返回酒识</button>
      <view class="detail-ticket">
        <view class="eyebrow">{{selected.category}}</view>
        <view class="page-title">{{selected.title}}</view>
        <view class="muted detail-desc" wx:if="{{selected.desc}}">{{selected.desc}}</view>
        <view class="meta detail-meta" wx:if="{{selected.meta}}">{{selected.meta}}</view>
      </view>
      <view class="fact-grid" wx:if="{{selected.facts.length}}">
        <view class="fact" wx:for="{{selected.facts}}" wx:key="label">
          <view class="fact-label">{{item.label}}</view>
          <view class="fact-value">{{item.value}}</view>
        </view>
      </view>
      <view class="article-paragraph" wx:for="{{selected.paragraphs}}" wx:key="*this">{{item}}</view>
      <view class="related-block" wx:if="{{selected.related.length}}">
        <view class="eyebrow">关联继续读</view>
        <view class="knowledge-ledger">
          <button class="ledger-row article-entry" wx:for="{{selected.related}}" wx:key="id" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openRelated">
            <view class="ledger-stub">
              <text class="stub-index">{{index > 8 ? index + 1 : '0' + (index + 1)}}</text>
              <text class="stub-sub">关联</text>
            </view>
            <view class="ledger-copy">
              <view class="note-title">{{item.title}}</view>
              <view class="note-excerpt">{{item.desc}}</view>
            </view>
            <view class="ledger-open"><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
          </button>
        </view>
      </view>
      <view class="practice">
        <view class="practice-title">杯中练习</view>
        <view class="practice-tip" wx:if="{{selected.tip}}">{{selected.tip}}</view>
        <button class="btn-primary practice-btn" bindtap="practice"><text>记下我的品鉴</text><image class="practice-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></button>
      </view>
      <view class="source-block">
        <view class="source-meta">
          <text class="source-origin">{{selected.type === 'remote-article' ? '酒文化公开内容' : '盲酌编辑部'}}</text>
          <text class="source-date" wx:if="{{selected.updated}}">整理于 {{selected.updated}}</text>
        </view>
        <view class="source-list" wx:if="{{selected.sources.length}}">
          <view class="source-heading"><text>参考资料</text><text>点击复制链接</text></view>
          <view class="source-item" wx:for="{{selected.sources}}" wx:key="url">
            <button class="source-link" data-url="{{item.url}}" bindtap="copy" aria-label="复制资料链接：{{item.title}}"><text class="source-title">{{item.title}}</text><text class="source-copy" aria-hidden="true">复制</text></button>
            <view class="source-checked" wx:if="{{item.checkedAt}}">核验于 {{item.checkedAt}}</view>
          </view>
        </view>
      </view>
    </view>
  </block>
  <block wx:else>
    <view class="content-panel article-detail">
      <button class="text-link" bindtap="close">← 返回酒款目录</button>
      <view class="detail-ticket">
        <view class="eyebrow">酒款目录 · {{selectedWine.brand}}</view>
        <view class="page-title">{{selectedWine.product}}</view>
      </view>
      <view class="fact-grid"><view class="fact"><view class="fact-label">香型</view><view class="fact-value">{{selectedWine.aromaType || '暂未提供'}}</view></view><view class="fact"><view class="fact-label">酒精度</view><view class="fact-value">{{selectedWine.degree || '暂未提供'}}</view></view><view class="fact"><view class="fact-label">目录参考价</view><view class="fact-value">{{selectedWine.defaultPrice !== null ? '¥ ' + selectedWine.defaultPrice : '暂未提供'}}</view></view></view>
      <view class="panel-note">资料来自酒款目录。参考价不代表实时售价，香型与度数请以实际酒标为准。</view>
      <view class="practice"><view class="practice-title">写下自己的感受</view><view class="practice-tip">酒款资料是线索，自己的观察才是手记。</view><button class="btn-primary practice-btn" bindtap="practice"><text>去记一杯</text><image class="practice-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></button></view>
    </view>
  </block>
</view>
