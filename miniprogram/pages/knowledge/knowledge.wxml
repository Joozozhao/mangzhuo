<brand-nav />
<view class="journal organized-page knowledge-page">
  <block wx:if="{{!selected}}">
    <view class="page-intro">
      <view class="heading-copy"><view class="compact-title">读懂杯中味</view><view class="heading-desc">认识香型，记录风味，慢读一款酒。</view></view>
      <image class="compact-art" src="/assets/brand/libai-knowledge.png" mode="aspectFit"/>
    </view>
    <view class="content-panel knowledge-controls">
      <view class="knowledge-map">
        <button wx:for="{{sections}}" wx:key="id" class="map-row {{section === item.id ? 'active' : ''}}" data-id="{{item.id}}" bindtap="switchSection" aria-pressed="{{section === item.id}}"><view class="map-name">{{item.title}}</view></button>
        <button class="map-row {{section === 'articles' ? 'active' : ''}}" bindtap="openArticles" aria-pressed="{{section === 'articles'}}"><view class="map-name">慢读文章</view></button>
      </view>
      <view class="search-wrap"><input class="input search" placeholder="搜{{activeSection.title}}中的内容" value="{{query}}" bindinput="search" confirm-type="search"/><button class="search-clear" wx:if="{{query}}" bindtap="clearSearch" aria-label="清除搜索">清除</button></view>
      <button class="resume-reading" wx:if="{{lastRead}}" bindtap="openLastRead"><view class="resume-copy"><text class="resume-kicker">继续阅读</text><text class="resume-title">{{lastRead.title}}</text></view><text class="resume-arrow">→</text></button>
    </view>
    <view class="content-panel knowledge-results">
    <view class="category-list" wx:if="{{section === 'articles'}}">
      <button wx:for="{{categories}}" wx:key="*this" class="category-chip {{articleCategory === item ? 'active' : ''}}" data-category="{{item}}" bindtap="chooseCategory">{{item}}</button>
    </view>
    <view class="panel-heading results-heading">
      <view class="panel-title">{{activeSection.title}}</view>
      <view class="meta">{{results.length}} {{section === 'articles' ? '篇' : '条'}}</view>
    </view>
    <button class="paper-row article-entry" wx:for="{{results}}" wx:key="id" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="open">
      <view class="meta">{{item.meta}}</view>
      <view class="row-title">{{item.title}}</view>
      <view class="muted">{{item.desc}}</view>
    </button>
    <view class="empty-note" wx:if="{{!results.length}}">
      <view class="empty-title">暂时没有找到相关内容</view>
      <view class="muted">试试更短的关键词，或查看本栏目全部内容。</view>
      <button class="text-link empty-action" wx:if="{{query}}" bindtap="clearSearch">清除搜索条件</button>
    </view>
    </view>
    <view class="quiet-footer">酒款资料以实际酒标和酒厂信息为准。</view>
  </block>
  <block wx:else>
    <view class="content-panel article-detail">
    <button class="text-link" bindtap="close">← 返回酒识</button>
    <view class="eyebrow">{{selected.category}}</view>
    <view class="page-title">{{selected.title}}</view>
    <view class="muted detail-desc" wx:if="{{selected.desc}}">{{selected.desc}}</view>
    <view class="meta detail-meta" wx:if="{{selected.meta}}">{{selected.meta}}</view>
    <view class="fact-grid" wx:if="{{selected.facts.length}}">
      <view class="fact" wx:for="{{selected.facts}}" wx:key="label">
        <view class="fact-label">{{item.label}}</view>
        <view class="fact-value">{{item.value}}</view>
      </view>
    </view>
    <view class="article-paragraph" wx:for="{{selected.paragraphs}}" wx:key="*this">{{item}}</view>
    <view class="related-block" wx:if="{{selected.related.length}}">
      <view class="eyebrow">关联继续读</view>
      <button class="paper-row article-entry" wx:for="{{selected.related}}" wx:key="id" data-type="{{item.type}}" data-id="{{item.id}}" bindtap="openRelated">
        <view class="row-title">{{item.title}}</view>
        <view class="muted">{{item.desc}}</view>
      </button>
    </view>
    <view class="practice">
      <view class="eyebrow">杯中练习</view>
      <view class="muted" wx:if="{{selected.tip}}">{{selected.tip}}</view>
      <button class="btn-primary" bindtap="practice">记下我的品鉴</button>
    </view>
    <view class="source-block">
      <view class="meta">{{selected.sources.length ? '出处与延伸阅读 · 点击复制链接' : '盲酌编辑部 · 品鉴记录建议'}}</view>
      <block wx:for="{{selected.sources}}" wx:key="url">
        <button class="source-link" data-url="{{item.url}}" bindtap="copy">{{item.title}} ↗</button>
        <view class="meta source-checked" wx:if="{{item.checkedAt}}">核验于 {{item.checkedAt}}</view>
      </block>
      <view class="meta" wx:if="{{selected.updated}}">整理于 {{selected.updated}}</view>
    </view>
    </view>
  </block>
</view>
