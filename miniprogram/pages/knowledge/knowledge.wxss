.search-wrap{position:relative;margin:0 0 28rpx;}
.search{margin:0;background:#eee7dc;border:0;height:82rpx;border-radius:8rpx;font-size:26rpx;padding:0 104rpx 0 28rpx;box-sizing:border-box;}
.search-clear{position:absolute;right:14rpx;top:50%;transform:translateY(-50%);padding:10rpx 14rpx;background:transparent;color:#893e32;font-size:23rpx;line-height:1.4;}
.map-heading{padding:0 0 12rpx;border-top:1rpx solid #d8cdbb;}
.map-heading .eyebrow{margin:22rpx 0 8rpx;}
.map-title{font-size:38rpx;line-height:1.4;letter-spacing:2rpx;color:#28251f;}
.map-intro{font-size:24rpx;margin-top:5rpx;}
.knowledge-map{margin-top:18rpx;border-top:1rpx solid #ded6ca;}
.map-row{display:flex;align-items:center;gap:16rpx;width:100%;min-height:112rpx;padding:16rpx 4rpx;background:transparent;border-bottom:1rpx solid #ded6ca;text-align:left;}
.map-row{box-sizing:border-box;display:flex;width:100%;min-width:0;}
.map-step{width:52rpx;flex-shrink:0;color:#aa9b84;font-size:24rpx;letter-spacing:1rpx;font-variant-numeric:tabular-nums;}
.map-copy{flex:1;min-width:0;}
.map-name{font-size:29rpx;line-height:1.45;color:#302b24;}
.map-caption{margin-top:4rpx;color:#746858;font-size:22rpx;line-height:1.55;}
.map-count{flex-shrink:0;color:#893e32;font-size:23rpx;font-variant-numeric:tabular-nums;}
.map-count text{color:#897b68;font-size:21rpx;}
.map-arrow{flex-shrink:0;color:#aa9b84;font-size:38rpx;font-family:serif;line-height:1;}
.map-row.active{background:linear-gradient(90deg,#f0e6d7 0%,rgba(240,230,215,0) 100%);}
.map-row.active .map-step{color:#893e32;}
.map-row.active .map-name{color:#893e32;}
.map-articles{margin-top:0;}
.results-heading{align-items:flex-end;border-bottom:1rpx solid #dcd3c4;padding-bottom:14rpx;}
.results-heading .eyebrow{margin:18rpx 0 6rpx;}
.results-heading .meta{padding-bottom:5rpx;}
.journal button.resume-reading{display:flex;align-items:center;gap:20rpx;width:100%;margin:0 0 28rpx;padding:22rpx 24rpx;background:#efe6d8;border-left:4rpx solid #893e32;text-align:left;}
.resume-mark{display:flex;align-items:center;justify-content:center;width:54rpx;height:54rpx;flex-shrink:0;border:1rpx solid #c9ad8b;border-radius:50%;color:#893e32;font-size:25rpx;}
.resume-copy{flex:1;min-width:0;}
.resume-kicker{color:#893e32;font-size:21rpx;letter-spacing:2rpx;}
.resume-title{overflow:hidden;margin:4rpx 0;color:#302b24;font-size:27rpx;line-height:1.45;text-overflow:ellipsis;white-space:nowrap;}
.resume-arrow{color:#893e32;font-size:30rpx;}
.category-list{display:flex;flex-wrap:wrap;gap:10rpx;margin:14rpx 0}
.category-chip{font-size:23rpx;line-height:60rpx;padding:0 19rpx;background:#eee7dc;color:#716454;border-radius:6rpx}
.category-chip.active{background:#893e32;color:#fff}
.collection-note{margin-top:28rpx;padding:18rpx 20rpx;background:#f0e9de;color:#7d7263;font-size:22rpx;line-height:1.7;}
.empty-title{font-size:30rpx;color:#494238;margin-bottom:8rpx;}
.empty-action{margin-top:8rpx;}
.paper-row{padding:24rpx 0}
.article-paragraph{font-size:29rpx;line-height:1.95;margin:32rpx 0}
.detail-desc{margin-top:16rpx}
.detail-meta{margin-top:10rpx}
.source-checked{margin:-6rpx 0 6rpx}
.fact-grid{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:28rpx}
.fact{flex:1;min-width:200rpx;background:#eee7dc;border-radius:8rpx;padding:16rpx 20rpx}
.fact-label{font-size:22rpx;color:#897b68;margin-bottom:6rpx}
.fact-value{font-size:26rpx;color:#3a3128}
.related-block{margin-top:38rpx}
.practice{border-top:1rpx solid #dcd3c4;margin-top:40rpx;padding-top:16rpx}
.practice button{margin-top:24rpx}
.source-block{margin-top:38rpx}
.source-link{text-align:left;white-space:normal;font-size:24rpx;color:#893e32;background:transparent;padding:12rpx 0;line-height:1.6}
.journal button.category-chip{width:auto !important;min-width:0;margin:0 !important;flex:none}
.journal button.article-entry{width:100% !important;margin:0;background:transparent;text-align:left;white-space:normal;line-height:1.5;border-radius:0;padding:24rpx 0}
.journal button.source-link{width:100% !important;margin:0;text-align:left}

/* Compact browsing: categories, search and resume form one group. */
.knowledge-page .knowledge-controls{border-bottom:1rpx solid #ddd2c1;padding-bottom:20rpx;margin-bottom:28rpx;}
.knowledge-page .knowledge-map{display:flex;align-items:stretch;margin:0 0 20rpx;border-bottom:1rpx solid #ded4c5;}
.knowledge-page button.map-row{position:relative;display:flex;flex:1;align-items:center;justify-content:center;width:auto;min-width:0;min-height:44px;padding:14rpx 4rpx 18rpx;margin:0;background:transparent;border:0;border-radius:0;text-align:center;line-height:1.45;}
.knowledge-page button.map-row.active{background:transparent;border:0;}
.knowledge-page button.map-row.active::after{content:'';position:absolute;left:18%;right:18%;bottom:-1rpx;height:4rpx;background:#893e32;border-radius:2rpx;}
.knowledge-page .map-name{font-size:24rpx;font-weight:400;white-space:nowrap;}
.knowledge-page button.map-row.active .map-name{font-weight:600;}
.knowledge-page .map-count{font-size:21rpx;color:#746653;}
.knowledge-page .search-wrap{margin:0;}
.knowledge-page .search{height:84rpx;min-height:44px;background:#eee7dc;border:0;border-radius:10rpx;font-family:inherit;}
.knowledge-page .search-clear{min-height:44px;min-width:44px;}
.knowledge-page button.resume-reading{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin:12rpx 0 0;padding:12rpx 0 0;border:0;min-height:44px;background:transparent;line-height:1.5;text-align:left;}
.knowledge-page .resume-copy{display:flex;align-items:center;gap:16rpx;min-width:0;}
.knowledge-page .resume-kicker{color:#746653;letter-spacing:0;flex-shrink:0;font-size:22rpx;}
.knowledge-page .resume-title{font-size:24rpx;margin:0;}
.knowledge-page .category-list{margin:0 0 16rpx;}
.knowledge-page .category-chip{min-height:44px;line-height:44px;}
.knowledge-page .results-heading{align-items:center;margin:0;padding-bottom:12rpx;}
.knowledge-page .results-heading .meta{padding:0;}
.knowledge-page button.article-entry{padding:22rpx 0;border-bottom:1rpx solid #e7dfd3;}
.knowledge-page button.article-entry:last-child{border-bottom:0;padding-bottom:4rpx;}
.knowledge-page .article-entry .row-title{font-size:30rpx;font-weight:500;}
.knowledge-page .article-entry .muted{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.knowledge-page .article-detail .page-title{font-family:"Songti SC","STSong",serif;font-size:40rpx;line-height:1.45;overflow-wrap:anywhere;}
.knowledge-page .article-paragraph{font-size:28rpx;line-height:1.9;margin:28rpx 0;color:#423a30;}
.knowledge-page .fact-grid{gap:12rpx;}
.knowledge-page .fact{min-width:180rpx;background:#f3eee5;}
.knowledge-page .article-detail{padding-top:4rpx;}
.knowledge-page .article-detail>.text-link{margin-bottom:24rpx;}
