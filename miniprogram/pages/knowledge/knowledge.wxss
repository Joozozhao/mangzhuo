.knowledge-map{display:flex;align-items:stretch;gap:4rpx;border-bottom:1rpx solid #d6ddcf;margin-bottom:28rpx;}
.knowledge-page button.map-row{flex:1;display:flex;align-items:center;justify-content:center;min-width:0;min-height:48px;margin:0;padding:16rpx 2rpx;background:transparent;border-bottom:3rpx solid transparent;border-radius:0;text-align:center;}
.map-name{font-size:13px;color:#687365;line-height:1.5;}
.knowledge-page button.map-row.active{border-bottom-color:#274d3b;}
.map-row.active .map-name{color:#274d3b;}
.search-wrap{position:relative;margin:0 0 24rpx;}
.knowledge-page .search{width:100%;height:88rpx;min-height:48px;background:#f1f2e9;border:1rpx solid #c8d3be;border-radius:0;padding:0 104rpx 0 24rpx;font-size:16px;box-sizing:border-box;}
.search-clear{position:absolute;right:8rpx;top:50%;transform:translateY(-50%);min-height:44px;min-width:44px;margin:0;padding:8rpx;color:#274d3b;background:transparent;font-size:12px;}
.knowledge-page button.resume-reading{display:flex;align-items:center;justify-content:space-between;width:100%;margin:0;padding:4rpx 0 20rpx;background:transparent;text-align:left;border-radius:0;gap:16rpx;}
.resume-copy{display:flex;align-items:center;min-width:0;gap:18rpx;}
.resume-kicker{font-size:12px;color:#687365;flex-shrink:0;}
.resume-title{font-size:14px;line-height:1.6;color:#374c3d;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.resume-arrow{color:#274d3b;font-size:20px;flex-shrink:0;}
.knowledge-page .knowledge-controls{margin-bottom:18rpx;}
.knowledge-page .results-heading{border-bottom:0;min-height:44px;padding:0 0 16rpx;}
.category-list{display:flex;flex-wrap:wrap;gap:12rpx;margin:4rpx 0 24rpx;}
.knowledge-page button.category-chip{width:auto;min-height:44px;padding:8rpx 18rpx;margin:0;background:#e9ede3;color:#4c5c4b;font-size:12px;border-radius:0;line-height:1.5;}
.knowledge-page button.category-chip.active{background:#274d3b;color:#f7f6ef;}
.knowledge-page button.article-entry{display:block;width:100%;margin:0;padding:28rpx 0;background:transparent;border-bottom:1rpx solid #d6ddcf;border-radius:0;text-align:left;}
.knowledge-page .article-entry .row-title{font-size:35rpx;margin:12rpx 0;}
.knowledge-page .article-entry .meta{font-size:12px;}
.knowledge-page .article-entry .muted{font-size:14px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;}
.knowledge-page button.featured-entry{padding:32rpx;background:#e9ede3;border:1rpx solid #d2dbc8;margin-bottom:8rpx;}
.knowledge-page .featured-entry .row-title{font-size:42rpx;line-height:1.5;margin:24rpx 0 18rpx;}
.read-more{display:flex;align-items:center;justify-content:space-between;gap:14rpx;color:#274d3b;font-size:14px;margin-top:28rpx;}
.empty-note{padding:36rpx 0;}.empty-title{font-family:"Songti SC","STSong",serif;font-size:20px;color:#28382e;margin-bottom:12rpx;}
.empty-action{margin-top:14rpx;}
.article-detail>.text-link{margin-bottom:28rpx;}
.knowledge-page .article-detail .page-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;line-height:1.5;color:#28382e;font-weight:400;overflow-wrap:anywhere;}
.article-detail .eyebrow{color:#274d3b;font-size:12px;letter-spacing:3rpx;margin:20rpx 0;}
.detail-desc{margin-top:18rpx;}.detail-meta{margin-top:14rpx;}
.article-paragraph{font-size:16px;line-height:1.95;margin:32rpx 0;color:#374c3d;overflow-wrap:anywhere;}
.fact-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:28rpx;}
.fact{flex:1;min-width:180rpx;padding:24rpx;background:#e9ede3;}
.fact-label{font-size:12px;color:#687365;margin-bottom:8rpx;}.fact-value{font-size:14px;color:#28382e;overflow-wrap:anywhere;}
.related-block{margin-top:40rpx;}.practice{border-top:1rpx solid #d6ddcf;margin-top:40rpx;padding-top:12rpx;}.practice button{margin-top:24rpx;}
.source-block{margin-top:38rpx;}.source-link{display:block;width:100%;min-height:44px;padding:14rpx 0;margin:0;background:transparent;text-align:left;color:#274d3b;font-size:12px;line-height:1.8;overflow-wrap:anywhere;}
.source-checked{margin-bottom:10rpx;}
.remote-feedback{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 0 18rpx;color:#706456;font-size:23rpx;line-height:1.6;}
.remote-feedback .text-link{flex-shrink:0;}
.knowledge-page .remote-more{display:flex;justify-content:center;margin:12rpx auto 0;}

.knowledge-page button.catalog-wine-row{display:flex;align-items:center;gap:18rpx;width:100%;padding:24rpx 0;margin:0;background:transparent;border-bottom:1rpx solid #d6ddcf;border-radius:0;text-align:left;}
.catalog-wine-row .record-body{flex:1;min-width:0;}.catalog-wine-row .row-title{font-size:32rpx;}.catalog-panel .catalog-feedback{margin:10rpx 0;}
