.knowledge-map{display:flex;align-items:stretch;gap:4rpx;border-bottom:1rpx solid #b9c5b1;margin:0 -12rpx 28rpx;}
.knowledge-page .map-row{flex:1;display:flex;align-items:center;justify-content:center;min-width:0;min-height:48px;margin:0;padding:0 2rpx;background:transparent;border:0;border-radius:0;text-align:center;}
.map-name{display:flex;align-items:center;justify-content:center;min-height:48px;min-width:108rpx;padding:0 4rpx;border-bottom:3rpx solid transparent;font-size:13px;color:#687365;line-height:1.5;}
.map-row.active .map-name{border-bottom-color:#274d3b;color:#274d3b;font-weight:600;}
.search-wrap{position:relative;margin:0 -12rpx 24rpx;}
.knowledge-page .search{width:100%;height:88rpx;min-height:48px;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;padding:0 104rpx 0 24rpx;font-size:16px;box-sizing:border-box;}
.search-clear{position:absolute;right:8rpx;top:50%;transform:translateY(-50%);min-height:44px;min-width:44px;margin:0;padding:8rpx;color:#274d3b;background:transparent;font-size:12px;}
.journal.organized-page .resume-ticket{display:flex;align-items:stretch;width:auto !important;min-height:132rpx;margin:0 -12rpx 24rpx;padding:0;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;text-align:left;overflow:visible;}
.resume-stub{position:relative;display:flex;flex:0 0 132rpx;align-items:center;justify-content:center;padding:18rpx 8rpx;background:#e5eadb;border-right:1rpx dashed #bac5b0;border-radius:11rpx 0 0 11rpx;}
.resume-stub::before,.resume-stub::after{content:"";position:absolute;right:-14rpx;width:24rpx;height:24rpx;border:1rpx solid #b9c5b1;border-radius:50%;background:#f7f6ef;z-index:1;}
.resume-stub::before{top:-13rpx;border-top-color:transparent;border-left-color:transparent;transform:rotate(45deg);}
.resume-stub::after{bottom:-13rpx;border-bottom-color:transparent;border-right-color:transparent;transform:rotate(45deg);}
.resume-stub-mark{font-family:"Songti SC","STSong",serif;font-size:32rpx;font-weight:600;letter-spacing:2rpx;color:#274d3b;}
.resume-main{flex:1;min-width:0;padding:20rpx 12rpx 20rpx 24rpx;display:flex;flex-direction:column;justify-content:center;}
.resume-kicker{font-size:12px;color:#687365;line-height:1.5;}
.resume-title{margin-top:4rpx;font-family:"Songti SC","STSong",serif;font-size:34rpx;font-weight:600;line-height:1.4;color:#28382e;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.resume-open{display:flex;align-items:center;justify-content:center;flex:0 0 64rpx;}
.knowledge-page .knowledge-controls{margin-bottom:18rpx;}
.knowledge-page .catalog-panel,.knowledge-page .knowledge-results{margin-left:-12rpx;margin-right:-12rpx;}
.knowledge-page .results-heading{border-bottom:0;min-height:44px;padding:0 0 18rpx;margin:0;align-items:baseline;}
.knowledge-page .results-heading .panel-title{font-size:52rpx;font-weight:600;line-height:1.35;}
.category-list{display:flex;flex-wrap:wrap;gap:12rpx;margin:4rpx 0 24rpx;}
.knowledge-page .category-chip{width:auto !important;min-height:40px;padding:8rpx 20rpx;margin:0;background:#fbfaf5;border:1rpx solid #b9c5b1;color:#4c5c4b;font-size:12px;border-radius:30rpx;line-height:1.5;}
.knowledge-page .category-chip.active{background:#274d3b;border-color:#274d3b;color:#f7f6ef;}
.knowledge-ledger,.wine-ledger{position:relative;border:1rpx solid #b9c5b1;border-radius:12rpx;background:#fbfaf5;}
.knowledge-ledger::before,.knowledge-ledger::after,.wine-ledger::before,.wine-ledger::after{content:"";position:absolute;left:130rpx;width:26rpx;height:26rpx;border:1rpx solid #b9c5b1;border-radius:50%;background:#f7f6ef;z-index:1;}
.knowledge-ledger::before,.wine-ledger::before{top:-14rpx;border-top-color:transparent;border-left-color:transparent;transform:rotate(45deg);}
.knowledge-ledger::after,.wine-ledger::after{bottom:-14rpx;border-bottom-color:transparent;border-right-color:transparent;transform:rotate(45deg);}
.journal.organized-page .ledger-row{display:flex;align-items:stretch;width:100% !important;max-width:none;min-width:0;min-height:186rpx;margin:0;padding:0;background:transparent;border-radius:0;text-align:left;}
.ledger-row:first-child{border-radius:11rpx 11rpx 0 0;}
.ledger-row:last-child{border-radius:0 0 11rpx 11rpx;}
.ledger-row+.ledger-row{border-top:1rpx solid #cbd3c2;}
.ledger-stub{display:flex;align-items:center;justify-content:center;flex-direction:column;flex:0 0 144rpx;min-width:0;gap:8rpx;padding:22rpx 8rpx;background:#e5eadb;border-right:1rpx dashed #bac5b0;text-align:center;}
.ledger-row:first-child .ledger-stub{border-top-left-radius:11rpx;}
.ledger-row:last-child .ledger-stub{border-bottom-left-radius:11rpx;}
.stub-index{font-family:Georgia,"Times New Roman",serif;font-size:38rpx;font-weight:600;line-height:1.25;color:#274d3b;}
.stub-sub{max-width:100%;font-size:11px;line-height:1.4;color:#687365;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.ledger-copy{flex:1;min-width:0;padding:22rpx 0 22rpx 24rpx;display:flex;flex-direction:column;justify-content:center;}
.note-aroma{font-size:12px;line-height:1.6;color:#687365;overflow-wrap:anywhere;}
.note-title{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:6rpx;font-family:"Songti SC","STSong","SimSun",serif;font-size:38rpx;font-weight:600;line-height:1.42;color:#28382e;overflow-wrap:anywhere;}
.note-excerpt{display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-top:8rpx;font-size:13px;line-height:1.7;color:#687365;overflow-wrap:anywhere;}
.ledger-open{display:flex;align-items:center;justify-content:center;flex:0 0 56rpx;}
.ledger-chevron{display:block;width:32rpx;height:32rpx;flex-shrink:0;}
.empty-ledger{padding:30rpx 28rpx;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;}
.empty-ledger-title{font-family:"Songti SC","STSong",serif;font-size:36rpx;line-height:1.5;color:#28382e;margin-bottom:12rpx;}
.empty-action{margin-top:14rpx;}
.article-detail>.text-link{margin-bottom:24rpx;}
.detail-ticket{padding:28rpx;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;}
.knowledge-page .article-detail .page-title{font-family:"Songti SC","STSong",serif;font-size:48rpx;line-height:1.45;color:#28382e;font-weight:600;overflow-wrap:anywhere;}
.article-detail .eyebrow{color:#274d3b;font-size:12px;letter-spacing:3rpx;margin:0 0 12rpx;}
.detail-desc{margin-top:16rpx;}.detail-meta{margin-top:12rpx;}
.article-paragraph{font-size:16px;line-height:1.95;margin:32rpx 0;color:#374c3d;overflow-wrap:anywhere;}
.fact-grid{display:flex;flex-wrap:wrap;gap:14rpx;margin-top:24rpx;}
.fact{flex:1;min-width:180rpx;padding:22rpx 24rpx;background:#fbfaf5;border:1rpx solid #b9c5b1;border-radius:12rpx;}
.fact-label{font-size:12px;color:#687365;padding-bottom:10rpx;margin-bottom:10rpx;border-bottom:1rpx dashed #bac5b0;}.fact-value{font-family:Georgia,"Songti SC",serif;font-size:15px;font-weight:600;color:#274d3b;overflow-wrap:anywhere;}
.related-block{margin-top:40rpx;}.related-block .eyebrow{margin-bottom:16rpx;}
.journal.organized-page.knowledge-page.is-reading{padding-bottom:calc(110rpx + 20px + env(safe-area-inset-bottom));}
.knowledge-page .article-detail{margin-bottom:0;}
.knowledge-page .practice{margin-top:32rpx;padding:24rpx;background:#edf0e7;border:1rpx solid #cbd3c2;border-radius:12rpx;}
.practice-title{color:#274d3b;font-family:"Songti SC","STSong","SimSun",serif;font-size:18px;font-weight:500;line-height:1.5;}
.practice-tip{margin-top:12rpx;color:#4c5c4b;font-size:13px;line-height:1.8;overflow-wrap:anywhere;text-wrap:balance;}
.journal.organized-page .practice-btn{gap:20rpx;min-height:48px;margin-top:24rpx;padding:20rpx 24rpx;text-align:left;}
.practice-arrow{display:block;flex-shrink:0;width:24px;height:24px;filter:brightness(0) invert(1);}
.source-block{margin-top:20rpx;}
.source-meta{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8rpx 20rpx;color:#687365;font-size:12px;line-height:1.7;}
.source-origin{min-width:0;overflow-wrap:anywhere;}
.source-date{white-space:nowrap;}
.source-list{margin-top:20rpx;padding-top:16rpx;border-top:1rpx solid #d6ddcf;}
.source-heading{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8rpx 20rpx;color:#687365;font-size:12px;line-height:1.7;margin-bottom:4rpx;}
.knowledge-page .source-link{display:flex;align-items:center;justify-content:space-between;gap:24rpx;width:100%;min-height:44px;padding:14rpx 0;margin:0;background:transparent;border-radius:0;text-align:left;color:#274d3b;font-size:13px;line-height:1.8;}
.source-title{flex:1;min-width:0;overflow-wrap:anywhere;}
.source-copy{flex-shrink:0;font-size:12px;}
.source-checked{margin:0 0 12rpx;color:#687365;font-size:12px;line-height:1.7;}
.source-item:last-child .source-checked{margin-bottom:0;}
.remote-feedback{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:0 0 18rpx;color:#706456;font-size:23rpx;line-height:1.6;}
.remote-feedback .text-link{flex-shrink:0;}
.knowledge-page .remote-more{display:flex;justify-content:center;margin:18rpx auto 0;}
.catalog-panel .catalog-feedback{margin:0 0 16rpx;font-size:12px;color:#687365;}
@media(max-width:350px){.knowledge-map,.search-wrap,.journal.organized-page .resume-ticket,.knowledge-page .catalog-panel,.knowledge-page .knowledge-results{margin-left:0;margin-right:0;}.map-name{min-width:84rpx;font-size:12px;}.ledger-stub{flex-basis:124rpx;}.knowledge-ledger::before,.knowledge-ledger::after,.wine-ledger::before,.wine-ledger::after{left:110rpx;}.ledger-copy{padding-left:18rpx;}.note-title{font-size:34rpx;}}
