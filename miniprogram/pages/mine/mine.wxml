<brand-nav/>
<view class="journal organized-page mine-page">
  <view class="page-kicker"><text>一 册 风 味 记 忆</text><text class="chapter-number">第四章 · 藏</text></view>
  <view class="chapter-hero-banner mine-hero">
    <image class="chapter-title-svg" src="/assets/brand/mine-hero-title.svg" mode="aspectFit" aria-label="一杯一记，皆是吾味，留下风味，留下记忆"/>
    <image class="chapter-pose-svg" src="/assets/brand/libai-mine.svg" mode="aspectFit" aria-label="李白执笔题记，盲酌品牌插画"/>
  </view>

  <view class="content-panel profile-panel">
    <view class="profile-ticket">
      <view class="profile-stub">
        <block wx:if="{{isWechat}}">
          <button class="stub-avatar-btn" bindtap="openAvatarModal" aria-label="点击修改头像">
            <image wx:if="{{avatarImg && !avatarLoadError}}" class="pe-avatar pe-avatar-logged" src="{{user.avatar}}" mode="aspectFill" binderror="onAvatarError"/>
            <view wx:else class="pe-avatar pe-avatar-logged pe-emoji">{{avatarImg ? '知' : (user.avatar && user.avatar !== '知味' ? user.avatar : '知')}}</view>
          </button>
          <button class="stub-nickname-btn" bindtap="openNicknameModal" aria-label="点击修改昵称 {{displayNickname}}">
            <text class="stub-nickname-text">{{displayNickname}}</text>
          </button>
        </block>
        <block wx:else>
          <button class="profile-avatar-action" bindtap="openProfileModal" data-field="all" aria-label="查看或编辑头像昵称">
            <image wx:if="{{avatarImg && !avatarLoadError}}" class="pe-avatar" src="{{user.avatar}}" mode="aspectFill" binderror="onAvatarError"/>
            <view wx:else class="pe-avatar pe-emoji">{{avatarImg ? '知味' : (user.avatar || '知味')}}</view>
          </button>
        </block>
      </view>
      <view class="profile-main">
        <view class="profile-title">我的品鉴档案</view>
        <view class="profile-state-row">
          <view class="profile-copy">
            <view class="identity-state">{{isWechat ? '微信已登录' : '游客模式'}}</view>
            <view class="mine-profile-hint">{{isWechat ? '点左侧头像或昵称即可修改' : '资料与手记保存在本机'}}</view>
          </view>
          <button wx:if="{{!isWechat}}" class="profile-action {{registering ? 'is-busy' : ''}}" bindtap="register" loading="{{registering}}" disabled="{{registering}}" aria-label="微信登录">{{registering ? '登录中' : '微信登录'}}</button>
          <button wx:else class="profile-action" bindtap="openProfileModal" data-field="all">{{profileCompleted ? '编辑资料' : '完善资料'}}</button>
        </view>
      </view>
    </view>
  </view>

  <view class="content-panel profile-stats" aria-label="本机品鉴统计">
    <view class="stat-ticket">
      <view class="stat-number">{{count}}</view>
      <view class="stat-copy">品酒手记</view>
    </view>
    <button class="stat-ticket stat-link" bindtap="rooms" aria-label="{{roomCount}} 场参与酒局，查看酒局">
      <view class="stat-number">{{roomCount}}</view>
      <view class="stat-copy"><text>参与酒局</text><image class="small-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></view>
    </button>
    <view class="stat-ticket">
      <view class="stat-number">{{aromaCount}}</view>
      <view class="stat-copy">已记香型</view>
    </view>
  </view>

  <view class="content-panel record-panel">
    <view class="panel-heading notes-heading">
      <view class="panel-title">个人手记</view>
      <button wx:if="{{notes.length}}" class="mine-checkin" bindtap="checkin"><text>再记一杯</text><image class="small-arrow light-arrow" src="/assets/icons/arrow-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    </view>
    <view class="note-ledger" wx:if="{{notes.length}}">
      <button class="ledger-row" wx:for="{{notes}}" wx:key="id" bindtap="openNote" data-id="{{item.id}}" aria-label="{{item.dateLabel}}，{{item.aromaType}}，{{item.title}}，查看手记">
        <view class="ledger-date">
          <text class="date-month-day">{{item.dateMonthDay}}</text>
          <text wx:if="{{item.dateYear}}" class="date-year">{{item.dateYear}}</text>
        </view>
        <view class="ledger-copy">
          <view class="note-aroma">{{item.aromaType}}</view>
          <view class="note-title">{{item.title}}</view>
          <view class="note-excerpt">{{item.note || '打开手记，回顾这一杯的风味。'}}</view>
        </view>
        <view class="ledger-open"><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></view>
      </button>
    </view>
    <view class="empty-ledger" wx:else>
      <view class="empty-ledger-title">手记尚空，杯中有待。</view>
      <view class="muted">从今天的一杯开始，留下自己的风味偏好。</view>
      <button class="mine-checkin empty-checkin" bindtap="checkin">写下第一篇</button>
    </view>
    <view class="panel-note">手记保存在本机，打开可制作分享酒卡。</view>
  </view>

  <view class="content-panel settings-panel">
    <button class="settings-row" bindtap="goAbout"><text>关于盲酌 · 隐私与协议</text><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button>
    <button wx:if="{{isWechat}}" class="settings-row logout-row" bindtap="logout"><text>退出微信登录</text><image class="ledger-chevron" src="/assets/icons/chevron-right.svg" mode="aspectFit" aria-hidden="true"/></button>
  </view>

  <view wx:if="{{showProfileModal}}" class="profile-modal-mask" bindtap="closeProfileModal">
    <view class="profile-modal-ticket" catchtap="noop">
      <view class="modal-kicker">
        <text>{{modalFocusField === 'avatar' ? '修 改 头 像' : (modalFocusField === 'nickname' ? '修 改 昵 称' : '编 辑 品 鉴 名 片')}}</text>
        <text>{{isWechat ? '微信已登录' : '本机保存'}}</text>
      </view>
      <view class="modal-title">你的品鉴名片</view>
      <view class="modal-section {{modalFocusField === 'avatar' ? 'is-highlighted' : ''}}">
        <view class="modal-label">品鉴头像</view>
        <button class="modal-avatar-picker" bindtap="onModalChooseAvatar" aria-label="选择或更换头像">
          <view class="modal-avatar-box">
            <image wx:if="{{(modalPendingImg || avatarImg) && !modalAvatarLoadError}}" class="modal-avatar-img" src="{{modalPendingImg ? modalPendingAvatar : user.avatar}}" mode="aspectFill" binderror="onModalAvatarError"/>
            <text wx:else class="modal-avatar-fallback">{{modalPendingImg || avatarImg ? '知' : (user.avatar || '知')}}</text>
          </view>
          <view class="modal-avatar-copy">
            <view class="modal-avatar-action">点击从相册更换头像</view>
            <view class="modal-avatar-hint">在酒局排行与分享酒卡中展示</view>
          </view>
        </button>
      </view>
      <view class="modal-section {{modalFocusField === 'nickname' ? 'is-highlighted' : ''}}">
        <view class="modal-label">品鉴昵称</view>
        <input class="input modal-nickname-input" type="text" maxlength="20" placeholder="请输入你的品鉴昵称" value="{{modalNickname}}" focus="{{modalFocusField === 'nickname'}}" bindinput="onModalNicknameInput" confirm-type="done"/>
      </view>
      <view class="modal-actions">
        <button class="modal-cancel-btn" bindtap="closeProfileModal" disabled="{{modalSaving}}">取消</button>
        <button class="modal-save-btn {{modalSaving ? 'is-busy' : ''}}" bindtap="saveProfileModal" loading="{{modalSaving}}" disabled="{{modalSaving}}">{{modalSaving ? '保存中…' : '保存修改'}}</button>
      </view>
    </view>
  </view>
</view>
