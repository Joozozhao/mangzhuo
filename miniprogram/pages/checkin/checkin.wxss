.checkin-intro { padding: 0 8rpx 32rpx; }
.checkin-page .eyebrow { margin: 0 0 12rpx; font-size: 12px; letter-spacing: 4rpx; }
.checkin-page .journal-title { margin-bottom: 12rpx; }
.checkin-page .muted { font-size: 14px; }
.form-section { margin-bottom: 24rpx; padding: 28rpx; border: 1rpx solid #e1e5da; border-radius: 16rpx; background: #fffdf8; }
.section-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx 16rpx; margin-bottom: 26rpx; }
.section-title { display: flex; align-items: center; gap: 14rpx; font-size: 16px; font-weight: 600; line-height: 1.5; }
.section-number { color: #78866f; font-family: Georgia, serif; font-size: 14px; font-weight: 400; }
.section-hint { color: #747e6e; font-size: 12px; line-height: 1.6; }
.checkin-page .field-label { display: flex; align-items: center; gap: 12rpx; }
.required-mark, .optional-mark { color: #7d8776; font-size: 12px; font-weight: 400; }
.required-mark { color: #6d795e; }
.checkin-page .catalog-feedback { flex-wrap: nowrap; min-height: 36rpx; margin: 12rpx 0 20rpx; gap: 12rpx; font-size: 12px; line-height: 1.6; }
.checkin-page .catalog-feedback > text { display: block; }
.checkin-page .catalog-retry { align-self: center; }
.aroma-field { padding-top: 4rpx; }
.picker-value { display: flex !important; align-items: center; justify-content: space-between; gap: 20rpx; }
.picker-placeholder { color: #747e6e; font-size: 14px; }
.picker-chevron { width: 14rpx; height: 14rpx; margin-right: 4rpx; border-right: 2rpx solid #75816d; border-bottom: 2rpx solid #75816d; transform: rotate(45deg) translateY(-4rpx); flex-shrink: 0; }
.flavor-heading { padding: 16rpx 8rpx 0; margin-bottom: 20rpx; }
.flavor-header { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.flavor-title { font-size: 16px; font-weight: 600; }
.flavor-count { color: #7b8574; font-size: 12px; }
.flavor-count.has-selection { color: #274d3b; }
.flavor-desc { margin: 8rpx 0 20rpx; color: #747e6e; font-size: 12px; line-height: 1.7; }
.flavor-terms { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; margin-bottom: 20rpx; }
.form-page button.flavor-chip { position: relative; display: flex; align-items: center; justify-content: center; width: 100%; min-width: 0; min-height: 44px; height: auto; margin: 0; padding: 12rpx 6rpx; border: 1rpx solid #e1e6da; border-radius: 10rpx; background: #f2f5ed; color: #58634f; font-family: inherit; font-size: 14px; font-weight: 400; line-height: 1.4; }
.form-page button.flavor-chip.active { border-color: #274d3b; background: #274d3b; color: #fff; font-weight: 500; }
.chip-label { min-width: 0; overflow-wrap: anywhere; }
.chip-check { position: absolute; top: 2rpx; right: 6rpx; font-size: 9px; line-height: 1.3; }
.checkin-page .flavor-input { min-height: 44px; height: 88rpx; background: #fffdf8; }
.note-section { padding-bottom: 18rpx; }
.note-section .section-heading { margin-bottom: 20rpx; }
.note-count { padding-top: 10rpx; color: #7c8675; font-size: 12px; text-align: right; }
.save-area { padding-top: 8rpx; }
.save-hint { padding: 18rpx 12rpx 0; color: #747e6e; font-size: 12px; line-height: 1.7; text-align: center; }
.field-error { margin-top: 10rpx; color: #ad5145; font-size: 12px; line-height: 1.6; }
@media (max-width: 350px) { .form-section { padding: 24rpx; } .flavor-terms { gap: 10rpx; } }
