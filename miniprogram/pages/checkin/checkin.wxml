<view class="journal">
  <view class="eyebrow">品酒打卡</view>
  <view class="journal-title">记下这一杯</view>
  <view class="muted">不必猜对，真实的感受就是好记录。</view>
  <form bindsubmit="submit">
    <text class="field-label">酒款 / 盲样名称 *</text>
    <input class="input" name="title" value="{{title}}" bindinput="onTitleInput" maxlength="40" placeholder="例如：青花汾酒，或 01 号盲样" />
    <view class="catalog-feedback"><text wx:if="{{catalogLoading}}">正在更新酒款目录…</text><block wx:elif="{{catalogError}}"><text>{{catalogSource === 'cache' ? '暂用最近目录' : '暂用离线目录'}}，也可手动填写。</text><button class="catalog-retry" bindtap="retryWineCatalog">重试</button></block><text wx:else>输入品牌或酒名，可从酒款目录选填。</text></view>
    <view class="wine-suggestions" wx:if="{{suggestions.length}}"><button wx:for="{{suggestions}}" wx:key="index" class="wine-suggestion" data-item="{{item}}" bindtap="applyWineSuggestion"><view class="wine-suggestion-title">{{item.product}}</view><view class="wine-suggestion-meta">{{item.brand}} · {{item.aromaType}} · {{item.degree}}</view></button></view>
    <text class="field-label">香型</text>
    <picker range="{{aromas}}" value="{{index}}" bindchange="choose">
      <view class="input picker-value">{{aromas[index]}}　⌄</view>
    </picker>
    <block wx:for="{{groups}}" wx:key="id" wx:for-item="group">
      <text class="field-label">{{group.title}}</text>
      <view class="muted flavor-desc" wx:if="{{group.desc}}">{{group.desc}}</view>
      <view class="flavor-terms">
        <button wx:for="{{group.terms}}" wx:for-item="term" wx:key="id" class="flavor-chip {{term.selected ? 'active' : ''}}" data-group="{{group.id}}" data-id="{{term.id}}" bindtap="toggleTerm">{{term.label}}</button>
      </view>
      <input class="input" name="{{group.id}}" maxlength="60" placeholder="{{placeholders[group.id]}}" />
    </block>
    <text class="field-label">此刻的手记</text>
    <textarea class="input" name="note" maxlength="180" placeholder="一句品评，或一段相聚的记忆" />
    <button class="btn-primary save" form-type="submit" loading="{{saving}}" disabled="{{saving}}">保存打卡 · 制作酒卡</button>
  </form>
</view>
