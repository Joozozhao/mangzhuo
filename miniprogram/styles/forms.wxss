/* Native form controls share one baseline; page layouts opt in with form-page. */
.form-page,
.journal.form-page {
  width: 100%;
  max-width: 900rpx;
  min-height: 100vh;
  margin: 0 auto;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  color: #28382e;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  line-height: 1.6;
}
.form-page view, .form-page text, .form-page input, .form-page textarea,
.form-page button, .form-page picker { box-sizing: border-box; }
.form-page input, .form-page textarea, .form-page button, .form-page picker { font-family: inherit; }
.form-page button {
  min-width: 44px;
  min-height: 44px;
  height: auto;
  margin: 0;
  padding: 16rpx 24rpx;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.5;
  white-space: normal;
  word-break: break-word;
}
.form-page button::after { border: 0; }
.form-page .page-title, .form-page .journal-title {
  font-family: "Songti SC", "STSong", "SimSun", serif;
  font-size: 48rpx;
  font-weight: 500;
  line-height: 1.4;
  letter-spacing: 2rpx;
  overflow-wrap: anywhere;
}
.form-page .page-desc, .form-page .muted { font-size: 14px; line-height: 1.7; color: #687365; }
.form-page .input {
  display: block;
  width: 100%;
  min-width: 0;
  min-height: 48px;
  height: 96rpx;
  margin: 0;
  padding: 0 24rpx;
  border: 1rpx solid #cbd2c5;
  border-radius: 12rpx;
  background: #fbfcf8;
  color: #28382e;
  font-size: 16px;
  line-height: 1.5;
}
.form-page .input:focus, .form-page .input.is-focused { border-color: #274d3b; background: #fff; }
.form-page .input.is-invalid { border-color: #ad5145; }
.form-page textarea.input { min-height: 112px; height: 224rpx; padding: 22rpx 24rpx; line-height: 1.7; }
.form-page .form-placeholder { color: #858d80; font-size: 14px; }
.form-page .field-label, .form-page .form-label {
  display: block;
  margin: 0 0 14rpx;
  color: #374c3d;
  font-size: 14px;
  font-weight: 500;
  line-height: 1.6;
  overflow-wrap: anywhere;
}
.form-page .card { padding: 28rpx; border: 1rpx solid #dde2d6; border-radius: 16rpx; background: #fffdf8; box-shadow: none; }
.form-page .form-row > .col, .form-page .sample-input { min-width: 0; }
.form-page button.btn-primary, .form-page button.btn-secondary, .form-page button.btn-dark {
  width: 100%;
  min-height: 48px;
  height: auto;
  padding: 24rpx;
  border-radius: 12rpx;
  font-family: inherit;
  font-size: 16px;
  line-height: 1.5;
}
.form-page button.btn-primary[disabled] { border-color: #b7c2b3; background: #b7c2b3; }
.catalog-feedback > text { flex: 1; min-width: 0; overflow-wrap: anywhere; }
.catalog-feedback .catalog-retry {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  min-width: 44px;
  min-height: 44px;
  height: auto;
  margin: 0 0 0 auto;
  padding: 8rpx 12rpx;
  line-height: 1.5;
}
.form-page .wine-suggestions { overflow: hidden; border-radius: 12rpx; }
.form-page button.wine-suggestion { min-width: 0; padding: 20rpx 24rpx; text-align: left; }
@media (max-width: 350px) {
  .form-page, .journal.form-page { padding-left: 28rpx; padding-right: 28rpx; }
}
