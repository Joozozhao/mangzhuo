<view class="tab-shell"><view class="tab-menu"><button wx:for="{{tabs}}" wx:key="path" class="tab-item {{selected === index ? 'is-active' : ''}}" data-index="{{index}}" bindtap="switchPage" aria-label="{{item.text}}{{selected === index ? '，当前页面' : ''}}"><view class="art-space"><image class="tab-art" src="{{item.image}}" mode="aspectFit"/></view><text class="tab-label">{{item.text}}</text><view class="active-mark" wx:if="{{selected === index}}"/></button></view></view>
