.tab-shell{position:fixed;bottom:0;left:0;right:0;z-index:100;background:#f7f3eb;border-top:1rpx solid #e2d7c3;box-shadow:0 -6rpx 20rpx rgba(84,57,29,.06);padding-bottom:env(safe-area-inset-bottom);padding-bottom:constant(safe-area-inset-bottom);}
.tab-menu{display:flex;height:112rpx;}
.tab-item{position:relative;display:flex;flex:1;min-width:0;width:25%;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:0;background:transparent;border-radius:0;line-height:1.3;}
.tab-item::after{border:0;}
.art-space{position:relative;width:52rpx;height:52rpx;display:flex;align-items:center;justify-content:center;}
.tab-art{width:48rpx;height:48rpx;opacity:.55;transition:transform .25s ease,opacity .25s ease;transform-origin:center center;}
.is-active .tab-art{opacity:1;transform:scale(1.08);}
.tab-label{font-family:"Songti SC","STSong","SimSun",serif;font-size:24rpx;color:#74614b;letter-spacing:3rpx;margin-top:6rpx;}
.is-active .tab-label{color:#893e32;font-weight:700;}
.active-mark{width:24rpx;height:4rpx;border-radius:2rpx;background:#893e32;margin-top:4rpx;}

.is-active{z-index:2;}
@media (prefers-reduced-motion:reduce){.tab-art{transition:none;}}
