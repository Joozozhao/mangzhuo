.tab-shell{position:fixed;bottom:0;left:0;right:0;z-index:100;background:#f7f6ef;border-top:1rpx solid #d6ddcf;padding-bottom:constant(safe-area-inset-bottom);padding-bottom:env(safe-area-inset-bottom);}
.tab-menu{display:flex;height:110rpx;min-height:56px;max-width:900rpx;margin:0 auto;}
.tab-item{position:relative;display:flex;flex:1;min-width:44px;min-height:44px;flex-direction:column;align-items:center;justify-content:center;margin:0;padding:10rpx 0 8rpx;background:transparent;border-radius:0;line-height:1.3;}
.tab-item::after{border:0;}
.art-space{display:flex;align-items:center;justify-content:center;width:48rpx;height:48rpx;}
.tab-art{display:block;width:42rpx;height:42rpx;opacity:.62;}
.is-active .tab-art{opacity:1;}
.tab-label{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:12px;color:#687365;margin-top:6rpx;}
.is-active .tab-label{color:#274d3b;font-weight:500;}
.active-mark{position:absolute;top:-1rpx;left:50%;transform:translateX(-50%);width:36rpx;height:3rpx;background:#274d3b;}
